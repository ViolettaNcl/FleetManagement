<Page x:Class="Zachet.Views.PageMenuAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Admin Menu">
    <Page.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="Black" Direction="315" ShadowDepth="5" BlurRadius="10" Opacity="0.5"/>
    </Page.Resources>
    <Grid Background="#F0F0FF">
        <StackPanel Margin="20">
            <TextBlock FontSize="36" FontWeight="Bold" Text="Admin Menu" Margin="0,0,0,30" Foreground="#333"/>

            <Border Background="#fff" CornerRadius="12" Padding="25" Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <Button Content="Управление водителями" Width="280" Height="55" Margin="0,0,0,12"
                            Background="#6A5ACD" Foreground="White" FontWeight="Bold" FontSize="16"
                            Cursor="Hand" Click="ManageUsersButton_Click"/>

                    <Button Content="Управление транспортом" Width="280" Height="55" Margin="0,0,0,12"
                            Background="#7B68EE" Foreground="White" FontWeight="Bold" FontSize="16"
                            Cursor="Hand" Click="ManageVehiclesButton_Click"/>

                    <Button Content="Управление маршрутами" Width="280" Height="55" Margin="0,0,0,20"
                            Background="#9370DB" Foreground="White" FontWeight="Bold" FontSize="16"
                            Cursor="Hand" Click="ManageRoutesButton_Click"/>

                    <!-- Выпадающая панель для бэкапа -->
                    <Expander Header="Экспорт данных (бэкап)" 
                              IsExpanded="False" 
                              Margin="5,10,0,0" 
                              Background="#F8F9FA" 
                              BorderBrush="#DEE2E6" 
                              BorderThickness="1" 
                              Padding="5">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </Expander.HeaderTemplate>

                        <StackPanel Margin="10,10,10,5">
                            <CheckBox x:Name="chkUsers"   Content="Пользователи (Users)"   IsChecked="True" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkDrivers" Content="Водители (Drivers)"     IsChecked="True" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkVehicles" Content="Транспорт (Vehicles)" IsChecked="True" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkRoutes"  Content="Маршруты (Routes)"     IsChecked="True" Margin="0,0,0,15"/>

                            <Button Content="Создать бэкап выбранных таблиц" 
                                    Width="280" Height="30" 
                                    Background="#BA55A7" Foreground="White" FontWeight="Bold" FontSize="15"
                                    Cursor="Hand" Click="BtnExportSelected_Click"/>
                        </StackPanel>
                    </Expander>

                    <Button Content="Log Out" Width="120" Height="30" Margin="0,10,0,0"
                            Background="#BA55D3" Foreground="White" FontWeight="Bold" FontSize="14"
                            Cursor="Hand" Click="LogoutButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>