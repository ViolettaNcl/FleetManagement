digraph G { graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.48",fontname="DejaVu Sans",fontsize=22,label="Local ML experiment lifecycle",labelloc=t,fontcolor="#142039"]; node [shape=box,style="rounded,filled",fillcolor="#f1f5ff",color="#8c9fc6",fontname="DejaVu Sans",fontsize=12,fontcolor="#142039",margin="0.18,0.12"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=10,fontcolor="#334155"]; a[label="Synthetic dataset\nseed and fingerprints"];b[label="Independent train / validation / test\nvehicle-disjoint where applicable"];c[label="Train-only fitting"];d[label="Validation / threshold / calibration"];e[label="Held-out evaluation + baseline"];f[label="Save model + SHA-256"];g[label="Reload and verify"];h[label="Local versioned registry\nNo automatic production promotion",fillcolor="#e9ddff"];a->b->c->d->e->f->g->h; }
