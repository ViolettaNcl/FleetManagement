digraph G { graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.48",fontname="DejaVu Sans",fontsize=22,label="PWA revision activation",labelloc=t,fontcolor="#142039"]; node [shape=box,style="rounded,filled",fillcolor="#f1f5ff",color="#8c9fc6",fontname="DejaVu Sans",fontsize=12,fontcolor="#142039",margin="0.18,0.12"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=10,fontcolor="#334155"]; a[label="New static revision"];b[label="Verify packaged asset hashes",shape=diamond];c[label="Keep working cache",fillcolor="#fee2e2"];d[label="Waiting service worker"];e[label="User confirms reload\nOther tabs closed?",shape=diamond];f[label="Retain previous active worker"];g[label="Activate verified revision\nSaved localStorage preserved",fillcolor="#dcfce7"];a->b;b->c[label="fail"];b->d[label="pass"];d->e;e->f[label="cancel / other tabs"];e->g[label="accept"]; }
