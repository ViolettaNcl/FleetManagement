digraph G { graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.48",fontname="DejaVu Sans",fontsize=22,label="GitHub Pages release evidence",labelloc=t,fontcolor="#142039"]; node [shape=box,style="rounded,filled",fillcolor="#f1f5ff",color="#8c9fc6",fontname="DejaVu Sans",fontsize=12,fontcolor="#142039",margin="0.18,0.12"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=10,fontcolor="#334155"]; a[label="Reviewed feature revision"];b[label="Fast-forward preview branch"];c[label="Build + package + browser smoke"];d[label="Eight CI workflows\nExact SHA + branch\nCodeQL validated SARIF"];e[label="Evidence gate",shape=diamond];f[label="Block release\nFix failure",fillcolor="#fee2e2"];g[label="Pages deploy"];h[label="Live verify: SHA, 36 hashes, UI",fillcolor="#dcfce7"];a->b;b->c;b->d;c->e;d->e;e->f[label="fail"];e->g[label="pass"];g->h; }
