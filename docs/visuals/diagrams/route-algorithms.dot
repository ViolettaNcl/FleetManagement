digraph G { graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.48",fontname="DejaVu Sans",fontsize=22,label="Euclidean closed-tour optimization",labelloc=t,fontcolor="#142039"]; node [shape=box,style="rounded,filled",fillcolor="#f1f5ff",color="#8c9fc6",fontname="DejaVu Sans",fontsize=12,fontcolor="#142039",margin="0.18,0.12"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=10,fontcolor="#334155"]; a[label="2–100 unique stops\nfirst stop = depot"];b[label="Original order baseline"];c[label="Nearest neighbor\nID tie-break"];d[label="2-opt\nat most 100 passes"];e[label="Multi-start 2-opt\nat most 8 additional starts"];f[label="Held–Karp exact\nat most 12 stops",fillcolor="#e9ddff"];g[label="Compare closed-tour lengths\nNo real-road routing"];a->b;a->c;b->d;c->d;d->e;a->f[label="small n"];b->g;c->g;d->g;e->g;f->g; }
