digraph G { graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.48",fontname="DejaVu Sans",fontsize=22,label="Confirmed fleet write",labelloc=t,fontcolor="#142039"]; node [shape=box,style="rounded,filled",fillcolor="#f1f5ff",color="#8c9fc6",fontname="DejaVu Sans",fontsize=12,fontcolor="#142039",margin="0.18,0.12"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=10,fontcolor="#334155"]; a[label="Authorize + receive UUID"]; b[label="Acquire process semaphore\n+ provider transaction lock"];c[label="Lookup actor/key receipt",shape=diamond];d[label="Replay original response"];e[label="Reject conflict"];f[label="Validate current fleet state",shape=diamond];g[label="Rollback / reject"];h[label="Save records + audit + receipt"];i[label="Commit"];j[label="Notify after commit"];a->b->c;c->d[label="same fingerprint"];c->e[label="different fingerprint"];c->f[label="new key"];f->g[label="invalid"];f->h[label="valid"];h->i->j; }
