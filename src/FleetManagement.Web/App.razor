@implements IAsyncDisposable
@inject IJSRuntime JS

<header>
    <div class="brand"><img class="brandicon" src="favicon.svg" alt="" /><div><h1>FleetManagement</h1><small>Fleet operations • interactive portfolio</small></div></div>
    <div class="actions"><span class="pill">Demo mode · local data</span><button class="secondary" @onclick="Reset">Reset demo</button></div>
</header>
<main>
    <nav aria-label="Fleet sections">
        @foreach (var item in Sections)
        {
            <button class="@(section == item ? "active" : "")" aria-pressed="@(section == item ? "true" : "false")" @onclick="() => Navigate(item)">@item</button>
        }
    </nav>
    @if (!string.IsNullOrEmpty(storageMessage)) { <p class="notice">@storageMessage</p> }
    @if (section == "Overview")
    {
        <div class="metrics">
            <div class="metric">Vehicles<strong>@fleet.Vehicles.Count</strong></div>
            <div class="metric">Drivers<strong>@fleet.Drivers.Count</strong></div>
            <div class="metric">In transit<strong>@fleet.Trips.Count(t => FleetRules.TripStatus(t, Now) == "In transit")</strong></div>
            <div class="metric">Service due<strong>@fleet.Vehicles.Count(v => FleetRules.Assess(v, Now).Status == "Due")</strong></div>
        </div>
        <section class="panel"><h2>Operations overview</h2><p class="muted">The original WPF-inspired interface, now running in the browser with C# business rules. Explore fleet operations, reporting, and the original desktop source on GitHub.</p>
        <div class="actions"><button @onclick='() => Navigate("Tracking")'>Open live tracking</button><button @onclick='() => Navigate("Dispatch")'>Plan a trip</button><button @onclick='() => Navigate("Maintenance")'>Review maintenance</button></div></section>
        <section class="panel"><h2>Try a guided scenario</h2><p class="muted">All records are synthetic. Changes are stored only in this browser, so you can experiment safely.</p>
        <div class="demojourney">
            <button class="secondary" @onclick='() => Navigate("Vehicles")'><strong>01 · Register</strong><small>Add a vehicle and test search or validation.</small></button>
            <button class="secondary" @onclick='() => Navigate("Dispatch")'><strong>02 · Schedule</strong><small>Find a free vehicle and driver.</small></button>
            <button class="secondary" @onclick='() => Navigate("Tracking")'><strong>03 · Track</strong><small>Advance the simulated clock.</small></button>
            <button class="secondary" @onclick='() => Navigate("Analytics")'><strong>04 · Report</strong><small>Export an Excel workbook.</small></button>
        </div></section>
        <section class="panel"><h2>Recent trips</h2>@TripTable()</section>
    }
    else if (section == "Vehicles" || section == "Drivers")
    {
        <FleetRegister @key="section" Fleet="fleet" IsVehicles="@(section == "Vehicles")" Today="Now" Changed="Persist" />
    }
    else if (section == "Optimization")
    {
        <RouteLab />
    }
    else if (section == "Calendar")
    {
        <FleetCalendarView Fleet="fleet" Now="Now" EditTrip="EditTrip" PlanTrip="PlanFromCalendar" />
    }
    else if (section == "Analytics")
    {
        <FleetAnalytics Fleet="fleet" Now="Now" />
    }
    else if (section == "Tracking")
    {
        <section class="panel"><h2>Live fleet tracking</h2><p class="muted">Simulated positions on a schematic route network, not real GPS or geographic coordinates. Advance the simulation or select a trip.</p>
            <div class="actions"><button @onclick="ToggleSimulation">@(playing ? "Pause simulation" : "Play simulation")</button><button class="secondary" @onclick="Advance">+ 15 minutes</button><small>Simulation time: @Now.ToString("dd MMM · HH:mm")</small></div>
            <div class="split" style="margin-top:16px">
                <svg class="map" viewBox="0 0 600 340" role="img" aria-label="Schematic routes and simulated vehicle positions">
                    @for (int x = 30; x < 600; x+=45) { <line class="road" x1="@x" y1="0" x2="@x" y2="340"/> }
                    @for (int y = 30; y < 340; y+=45) { <line class="road" x1="0" y1="@y" x2="600" y2="@y"/> }
                    <path class="track" d="M110 55 L300 160"/><path class="track" d="M65 165 L535 105"/><path class="track" d="M300 160 L420 285"/>
                    <g fill="#fff" stroke="#6a5acd" stroke-width="2"><circle cx="110" cy="55" r="9"/><circle cx="300" cy="160" r="9"/><circle cx="65" cy="165" r="9"/><circle cx="535" cy="105" r="9"/><circle cx="420" cy="285" r="9"/></g>
                    <text x="120" y="45">North depot</text><text x="310" y="185">Central hub</text><text x="30" y="150">West depot</text><text x="465" y="85">East terminal</text><text x="430" y="310">South depot</text>
                    @foreach (var t in fleet.Trips.Where(t => t.Track is >= 0 and <= 2 && FleetRules.TripStatus(t, Now) == "In transit"))
                    {
                        var point=Position(t); <g><circle cx="@point.X" cy="@point.Y" r="@(selectedTrip==t.Id?13:9)" fill="#6a0dad" stroke="white" stroke-width="3"/><text x="@(point.X+15)" y="@(point.Y-10)">@VehicleName(t.VehicleId)</text></g>
                    }
                </svg>
                <div class="tripselect"><h3>Trips</h3>
                @foreach (var t in fleet.Trips.Where(t => t.Track >= 0)) { <button class="@(selectedTrip==t.Id?"":"secondary")" @onclick="()=>selectedTrip=t.Id">#@t.Id · @VehicleName(t.VehicleId)<br/><small style="color:inherit">@FleetRules.TripStatus(t,Now)</small></button> }
                @if (fleet.Trips.FirstOrDefault(t=>t.Id==selectedTrip) is Trip selected) {
                    <p>@selected.Origin → @selected.Destination<br/><small>Progress: @((FleetRules.Progress(selected,Now)*100).ToString("0"))% · ETA @selected.End.ToString("HH:mm")</small></p>
                    <div class="progress"><i style="width:@((FleetRules.Progress(selected,Now)*100).ToString("0",CultureInfo.InvariantCulture) + "%")"></i></div>
                }
                </div>
            </div>
        </section>
    }
    else if (section == "Dispatch")
    {
        <section class="panel"><h2>Intelligent dispatch planner</h2>@if (editingTripId.HasValue) { <p class="notice">Editing trip #@editingTripId</p> }<p class="muted">Find an available vehicle and driver. The C# scheduler checks overlapping assignments and avoids vehicles with overdue service when recommending a pair.</p>
        <div class="formgrid">
            <label>Origin<input @bind="origin" /></label><label>Destination<input @bind="destination" /></label><label>Distance (km)<input type="number" min="1" @bind="distance" /></label>
            <label>Start<input type="datetime-local" @bind="start" /></label><label>End<input type="datetime-local" @bind="end" /></label>
            <label>Vehicle<select @bind="vehicleId"><option value="0">Select vehicle</option>@foreach(var v in fleet.Vehicles){<option value="@v.Id">@v.Plate · @v.Model</option>}</select></label>
            <label>Driver<select @bind="driverId"><option value="0">Select driver</option>@foreach(var d in fleet.Drivers){<option value="@d.Id">@d.Name</option>}</select></label>
        </div>
        <div class="actions"><button class="secondary" @onclick="Recommend">Suggest assignment</button><button @onclick="SaveTrip" disabled="@(fleet.Vehicles.Count == 0 || fleet.Drivers.Count == 0)">@(editingTripId.HasValue ? "Save changes" : "Create trip")</button>@if(editingTripId.HasValue){<button class="secondary" @onclick="CancelEdit">Cancel edit</button>}</div>
        @if(!string.IsNullOrEmpty(feedback)){<p role="status" class="@(isError?"error":"notice")">@feedback</p>}
        </section><section class="panel"><h2>Trip schedule</h2>@TripTable()</section>
    }
    else if(section=="Maintenance")
    {
        <section class="panel"><h2>Predictive maintenance · rule-based</h2><p class="muted">Explainable assessment based on service mileage and time intervals. Not a trained ML model or a safety certification.</p>
        <div class="tablewrap"><table><thead><tr><th>Vehicle</th><th>Remaining km</th><th>Remaining days</th><th>Health</th><th>Explanation</th><th>Action</th></tr></thead><tbody>
        @foreach(var v in fleet.Vehicles){var a=FleetRules.Assess(v,Now);<tr><td>@v.Plate · @v.Model</td><td>@a.RemainingKm.ToString("N0")</td><td>@a.RemainingDays</td><td><span class="pill @a.Status.ToLowerInvariant()">@a.Status</span></td><td>@a.Reason</td><td><button class="secondary" @onclick="()=>RecordService(v.Id)">Record service</button></td></tr>}
        </tbody></table></div></section>
    }
    <footer class="footer">FleetManagement · WPF-inspired .NET WebAssembly demo · synthetic data only · <a href="https://github.com/ViolettaNcl/FleetManagement">Source repository</a></footer>
</main>
@code {
    private readonly string[] Sections = ["Overview","Vehicles","Drivers","Tracking","Dispatch","Calendar","Maintenance","Analytics","Optimization"];
    private const string Key="fleetmanagement.demo.v1";
    private FleetData fleet=FleetRules.Sample(DateTime.Now);
    private string section="Overview",origin="North depot",destination="Central hub",feedback="",storageMessage="";
    private int distance=132,vehicleId=1,driverId=1,selectedTrip=101;
    private int? editingTripId;
    private DateTime start=DateTime.Now.AddHours(1),end=DateTime.Now.AddHours(2);
    private DateTime Now=DateTime.Now;
    private bool playing,isError;
    private PeriodicTimer? timer;
    private CancellationTokenSource cts=new();
    private Task? timerTask;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)return;
        try { var json=await JS.InvokeAsync<string?>("localStorage.getItem",Key); if(!string.IsNullOrWhiteSpace(json)){var saved=JsonSerializer.Deserialize(json, DemoJsonContext.Default.DemoSnapshot); if(saved?.Data is not null && saved.Data.Vehicles is not null && saved.Data.Drivers is not null && saved.Data.Trips is not null){fleet=saved.Data;Now=saved.Now;start=Now.AddHours(1);end=Now.AddHours(2);}} }
        catch (Exception) {storageMessage="Local storage is unavailable; changes are session-only.";}
        timer=new PeriodicTimer(TimeSpan.FromSeconds(1)); timerTask=RunClock(); StateHasChanged();
    }
    private async Task RunClock(){try{while(await timer!.WaitForNextTickAsync(cts.Token)){await InvokeAsync(()=>{if(playing){Now=Now.AddMinutes(2);StateHasChanged();}});}}catch(OperationCanceledException){}}
    private async Task Persist(){try{await JS.InvokeVoidAsync("localStorage.setItem",Key,JsonSerializer.Serialize(new DemoSnapshot(fleet,Now), DemoJsonContext.Default.DemoSnapshot));}catch(Exception){storageMessage="Unable to save locally; changes are session-only.";}}
    private void Navigate(string item){section=item;feedback="";if(item=="Dispatch"){if(!fleet.Vehicles.Any(v=>v.Id==vehicleId))vehicleId=fleet.Vehicles.FirstOrDefault()?.Id??0;if(!fleet.Drivers.Any(d=>d.Id==driverId))driverId=fleet.Drivers.FirstOrDefault()?.Id??0;}}
    private async Task ToggleSimulation(){playing=!playing;if(!playing)await Persist();}
    private async Task Advance(){Now=Now.AddMinutes(15);await Persist();}
    private async Task Reset(){if(!await JS.InvokeAsync<bool>("confirm","Reset all demo data?"))return;playing=false;Now=DateTime.Now;fleet=FleetRules.Sample(Now);start=Now.AddHours(1);end=Now.AddHours(2);vehicleId=driverId=1;selectedTrip=101;editingTripId=null;feedback="";await Persist();}
    private string VehicleName(int id)=>fleet.Vehicles.FirstOrDefault(v=>v.Id==id)?.Plate??"Unknown";
    private string DriverName(int id)=>fleet.Drivers.FirstOrDefault(d=>d.Id==id)?.Name??"Unknown";
    private void Recommend(){var a=FleetRules.Recommend(fleet,start,end,Now,editingTripId);isError=a is null;if(a is null){feedback="No available service-ready assignment for this interval.";return;}vehicleId=a.VehicleId;driverId=a.DriverId;feedback=$"Suggested {VehicleName(vehicleId)} and {DriverName(driverId)}.";}
    private void EditTrip(Trip trip){if(FleetRules.CanChangeTrip(fleet,trip.Id,Now) is string invalid){feedback=invalid;isError=true;return;}editingTripId=trip.Id;origin=trip.Origin;destination=trip.Destination;distance=trip.Distance;start=trip.Start;end=trip.End;vehicleId=trip.VehicleId;driverId=trip.DriverId;feedback="";section="Dispatch";}
    private void PlanFromCalendar(DateTime date){CancelEdit();start=date.Date.AddHours(9);if(start<=Now)start=Now.AddHours(1);end=start.AddHours(1);Navigate("Dispatch");}
    private void CancelEdit(){editingTripId=null;origin="North depot";destination="Central hub";distance=132;start=Now.AddHours(1);end=Now.AddHours(2);feedback="";}
    private async Task DeleteTrip(Trip trip){if(FleetRules.CanChangeTrip(fleet,trip.Id,Now) is string invalid){feedback=invalid;isError=true;return;}if(!await JS.InvokeAsync<bool>("confirm",$"Delete scheduled trip #{trip.Id}?"))return;fleet.Trips.RemoveAll(t=>t.Id==trip.Id);if(editingTripId==trip.Id)CancelEdit();feedback=$"Trip #{trip.Id} deleted.";isError=false;await Persist();}
    private async Task SaveTrip(){
        if(editingTripId is int existingId && FleetRules.CanChangeTrip(fleet,existingId,Now) is string invalid){feedback=invalid;isError=true;return;}
        if(start<=Now){feedback="A new or edited trip must start in the future.";isError=true;return;}
        var id=editingTripId??fleet.Trips.Select(t=>t.Id).DefaultIfEmpty(100).Max()+1;
        var old=fleet.Trips.FirstOrDefault(t=>t.Id==id);
        var track=old is not null && old.Origin==origin.Trim() && old.Destination==destination.Trim()?old.Track:-1;
        var trip=new Trip(id,vehicleId,driverId,origin.Trim(),destination.Trim(),start,end,distance,track);
        var error=FleetRules.ValidateTrip(fleet,trip);isError=error is not null;if(error is not null){feedback=error;return;}
        if(old is null)fleet.Trips.Add(trip);else fleet.Trips[fleet.Trips.FindIndex(t=>t.Id==id)]=trip;
        CancelEdit();feedback=$"Trip #{id} saved.";await Persist();
    }
    private async Task RecordService(int id){var index=fleet.Vehicles.FindIndex(v=>v.Id==id);if(index<0)return;var v=fleet.Vehicles[index];fleet.Vehicles[index]=v with{LastService=Now,LastServiceMileage=v.Mileage};await Persist();}
    private (int X,int Y) Position(Trip t){var p=FleetRules.Progress(t,Now);var (x1,y1,x2,y2)=t.Track switch{0=>(110,55,300,160),1=>(65,165,535,105),_=>(300,160,420,285)};return ((int)(x1+(x2-x1)*p),(int)(y1+(y2-y1)*p));}
    private RenderFragment TripTable()=> @<div class="tablewrap"><table><thead><tr><th>Trip</th><th>Route</th><th>Vehicle</th><th>Driver</th><th>Start</th><th>End</th><th>Distance</th><th>Status</th>@if(section=="Dispatch"){<th>Actions</th>}</tr></thead><tbody>
    @foreach(var t in fleet.Trips.OrderByDescending(t=>t.Start)){var status=FleetRules.TripStatus(t,Now);<tr><td>#@t.Id</td><td>@t.Origin → @t.Destination</td><td>@VehicleName(t.VehicleId)</td><td>@DriverName(t.DriverId)</td><td>@t.Start.ToString("dd MMM HH:mm")</td><td>@t.End.ToString("dd MMM HH:mm")</td><td>@t.Distance km</td><td><span class="pill @status.Replace(" ","").ToLowerInvariant()">@status</span></td>@if(section=="Dispatch"){<td>@if(status=="Scheduled"){<div class="actions"><button class="secondary" @onclick="()=>EditTrip(t)">Edit</button><button class="delete" @onclick="()=>DeleteTrip(t)">Delete</button></div>}else{<small>History</small>}</td>}</tr>}
    </tbody></table></div>;
    public async ValueTask DisposeAsync(){cts.Cancel();timer?.Dispose();if(timerTask is not null)await timerTask;cts.Dispose();}
}
