@using FleetManagement.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

@{var currentAlerts=FleetAdvisor.Assess(fleet,Now,driverShifts,requireShifts,vehicleReservations,russian:language=="ru");}
<div class="demo-shell v4-shell @(darkTheme?"dark-theme":"") @(collapsed?"sidebar-collapsed":"") @(compactDashboard&&section=="Overview"?"dashboard-compact":"") @(visualMode=="premium"?"premium-workspace":"") @(workspaceDensity=="compact"?"workspace-dense":"")">
<a class="skip-workspace" href="#fleet-content">@T("Skip to content")</a>
<header class="workspace-header" lang="@language">
    <div class="brand"><img class="brandicon" src="favicon.svg" alt="" /><div><h1>FleetManagement</h1><small>@T("Fleet operations workspace")</small></div></div>
    <div class="actions"><button class="secondary command-search toolbar-icon-button" data-command-search="true" @onclick="OpenSearch" aria-keyshortcuts="Control+k Meta+k" title="@T("Quick search")"><WorkspaceIcon Name="Search" /><span class="toolbar-label toolbar-accessible-label">@T("Quick search")</span><kbd aria-hidden="true">Ctrl K</kbd></button><button class="secondary theme-action toolbar-icon-button" aria-pressed="@(darkTheme?"true":"false")" @onclick="ToggleTheme" aria-label="@T(darkTheme?"Light theme":"Dark theme")" title="@T(darkTheme?"Light theme":"Dark theme")"><WorkspaceIcon Name="@(darkTheme?"Sun":"Moon")"/><span class="toolbar-label">@T(darkTheme?"Light theme":"Dark theme")</span></button><label class="demo-language"><span class="toolbar-language-label">@T("Language")</span><select @bind="language" @bind:after="PersistPreferences" aria-label="@T("Language")"><option value="en">English</option><option value="ru">Русский</option></select></label><span class="pill demo-status"><span class="signal-dot" aria-hidden="true"></span>@T("Demo mode · local data")</span><button class="secondary header-alerts" @onclick='()=>Navigate("Notifications")' ><WorkspaceIcon Name="Assistant"/><span class="toolbar-accessible-label">@T("Alerts")</span> <strong class="alert-counter">@currentAlerts.Count</strong></button><button class="secondary reset-action toolbar-icon-button" @onclick="Reset" aria-label="@T("Reset demo")" title="@T("Reset demo")"><WorkspaceIcon Name="Reset"/><span class="toolbar-label">@T("Reset demo")</span></button></div>
</header>
<main lang="@language" class="workspace-layout">
    <button class="mobile-nav-toggle secondary" aria-expanded="@(mobileNav?"true":"false")" aria-controls="workspace-nav" @onclick="ToggleMobileMenu"><span aria-hidden="true">☰</span> @T("Modules") · @T(section)</button>
    <nav id="workspace-nav" class="fleet-sidebar @(mobileNav?"nav-open":"")" aria-label="@T("Fleet sections")">
        <div class="nav-eyebrow">@T("Workspace")<button class="secondary sidebar-collapse" @onclick="ToggleSidebar" aria-label="@T(collapsed?"Expand sidebar":"Collapse sidebar")" title="@T(collapsed?"Expand sidebar":"Collapse sidebar")">@(collapsed?"»":"«")</button></div><label class="nav-search">@T("Find section")<input @ref="navInput" type="search" maxlength="120" @bind="navQuery" @bind:event="oninput" placeholder="@T("Search modules")" aria-label="@T("Find section")" aria-describedby="nav-hint" @onkeydown="SearchKey"/><small id="nav-hint">@T("Enter to open a single match; Escape clears search.") @T("Use arrow keys to browse results.")</small></label>
        @if(!string.IsNullOrWhiteSpace(navQuery)){<p class="nav-search-count" role="status">@T("Matching commands"): @SearchMatchCount</p>}
        @if(!string.IsNullOrWhiteSpace(navQuery)){<div class="v4-search-actions">@foreach(var action in QuickActions.Where(a=>MatchesSection(a.Label))){<button class="secondary" @onclick="()=>RunQuickAction(action.Key)">@T(action.Label)</button>}</div>}
        @if(string.IsNullOrWhiteSpace(navQuery)&&!collapsed){<div class="nav-quick-access">@if(favorites.Count>0){<small>@T("Favorites")</small>@foreach(var item in favorites){<button aria-label="@($"{T("Favorite")}: {T(item)}")" @onclick="()=>Navigate(item)"><WorkspaceIcon Name="@item"/><span>@T(item)</span></button>}}@if(recent.Count>0){<div class="recent-nav-heading"><small>@T("Recent modules")</small><button class="secondary" @onclick="ClearRecent">@T("Clear recent")</button></div>@foreach(var item in recent.Take(3)){<button aria-label="@($"{T("Recent")}: {T(item)}")" @onclick="()=>Navigate(item)"><WorkspaceIcon Name="@item"/><span>@T(item)</span></button>}}</div>}
        @if(!NavigationGroups.SelectMany(g=>g.Items).Any(MatchesSection)&&!QuickActions.Any(a=>MatchesSection(a.Label))){<div class="nav-empty"><p>@T("No matching modules")</p><button class="secondary" @onclick="()=>navQuery=string.Empty">@T("Clear search")</button></div>}
        @foreach(var group in NavigationGroups.Where(g=>g.Items.Any(MatchesSection)))
        {
            <div class="nav-group">
                <h2>@T(group.Name)</h2>
                @foreach(var item in group.Items.Where(MatchesSection))
                {
                    <button class="@(section == item ? "active" : "")" aria-pressed="@(section == item ? "true" : "false")" aria-current="@(section == item ? "page" : null)" aria-label="@T(item)" title="@T(item)" @onclick="() => Navigate(item)"><span class="nav-icon" aria-hidden="true"><WorkspaceIcon Name="@item" /></span><span class="nav-label">@T(item)</span></button>
                }
            </div>
        }
    </nav>
    <div class="fleet-content" id="fleet-content" tabindex="-1" @ref="contentRoot">
    <div class="workspace-breadcrumb"><span>@T("Fleet workspace")</span><span aria-hidden="true">/</span><strong>@T(section)</strong><button class="secondary favorite-action" aria-label="@T(favorites.Contains(section)?"Remove favorite":"Add favorite")" aria-pressed="@(favorites.Contains(section)?"true":"false")" @onclick="ToggleFavorite">@(favorites.Contains(section)?"★":"☆")</button><span class="workspace-clock">@T("Simulation time") · @Now.ToString("HH:mm")</span>@if(buildRevision.Length==7){<span class="build-revision" title="Published source revision" data-testid="build-revision">@buildRevision</span>}</div>
    <div class="v4-context-actions contextual-toolbar @(quickActionsExpanded?"actions-expanded":"")">
        @if(ContextAction is var primary&&primary.Key.Length>0){<button class="quick-primary" @onclick="()=>RunQuickAction(primary.Key)"><WorkspaceIcon Name="@primary.Icon"/> @T(primary.Label)</button>}
        <button class="secondary context-action-toggle" aria-expanded="@(quickActionsExpanded?"true":"false")" aria-controls="v4-secondary-actions" @onclick="()=>quickActionsExpanded=!quickActionsExpanded">@T("Quick actions") <span aria-hidden="true">⌄</span></button>
        <div class="v4-secondary-actions" id="v4-secondary-actions" hidden="@(!quickActionsExpanded)">
            @foreach(var action in QuickActions.Where(x=>x.Key!=ContextAction.Key)){<button class="secondary" @onclick="()=>RunQuickAction(action.Key)">@T(action.Label)</button>}
            <button class="secondary" @onclick='()=>Navigate("Help & settings")'>@T("Help & settings")</button>
        </div>
    </div>
    @if(language=="ru"){<p class="localization-note">@T("Some technical labels and generated records remain in English.")</p>}
    @if (!string.IsNullOrEmpty(storageMessage)) { <p class="notice">@T(storageMessage)</p> }
    @if(ModuleBanner(section) is var banner && banner.Art.Length>0){
        <div class="@("module-intro module-art-"+banner.Art)"><div><span class="module-kicker">@T("Workspace")</span><strong>@T(banner.Title)</strong><p>@T(banner.Description)</p></div><span class="module-watermark" aria-hidden="true"><WorkspaceIcon Name="@section"/></span></div>
    }
    @if (section == "Overview")
    {
        <section class="panel command-hero neon-hero">
            <div class="hero-copy"><span class="hero-kicker"><i aria-hidden="true"></i> @T("Operations command center")</span><h2>@T("Operations overview")</h2><p class="muted">@T("Fleet command center · monitor schedules, maintenance and operational exceptions in one place. Synthetic records, local browser storage.")</p>
            <div class="actions hero-actions"><button @onclick='() => Navigate("Tracking")'>@T("Open live tracking") <span aria-hidden="true">↗</span></button><button class="secondary" @onclick='() => Navigate("Dispatch")'>@T("Plan a trip")</button><button class="secondary" @onclick='() => Navigate("Maintenance")'>@T("Review maintenance")</button></div></div>
            <div class="hero-art-space" aria-hidden="true"></div>
        </section>
        <section class="panel dashboard-preferences" aria-labelledby="dashboard-preferences-title">
            <div class="dashboard-preference-heading"><div><h2 id="dashboard-preferences-title">@T("Dashboard layout")</h2><p class="muted">@T("Choose a workspace view. Core metrics and alerts stay visible.")</p></div>
                <button class="secondary" aria-expanded="@(dashboardSettingsOpen?"true":"false")" aria-controls="dashboard-preferences-fields" @onclick="()=>dashboardSettingsOpen=!dashboardSettingsOpen"><WorkspaceIcon Name="Overview"/> @T("Customize dashboard")</button>
            </div>
            <div id="dashboard-preferences-fields" class="dashboard-preference-fields" hidden="@(!dashboardSettingsOpen)">
                <label>@T("Dashboard preset")<select aria-label="@T("Dashboard preset")" value="@dashboardPreset" @onchange="ChangeDashboardPreset"><option value="full">@T("Full overview")</option><option value="operations">@T("Operations focus")</option><option value="intelligence">@T("Intelligence focus")</option><option value="custom">@T("Custom layout")</option></select></label>
                <fieldset><legend>@T("Optional panels")</legend>
                    @foreach(var panel in DashboardPanels){<label class="dashboard-check"><input type="checkbox" checked="@dashboardPanels.Contains(panel.Key)" @onchange="e=>ToggleDashboardPanel(panel.Key,e.Value is true)"/><span>@T(panel.Label)</span></label>}
                </fieldset>
                <label class="dashboard-check"><input type="checkbox" @bind="compactDashboard" @bind:after="SaveDashboardPreferences"/><span>@T("Compact dashboard")</span></label>
                <button class="secondary dashboard-reset" @onclick="ResetDashboardPreferences">@T("Restore default layout")</button>
            </div>
        </section>
        <div class="metrics dashboard-kpis">
            @foreach(var metric in OverviewMetrics()){
                <button class="metric metric-action secondary" @onclick="()=>Navigate(metric.Section)">
                    <span class="metric-top"><span>@T(metric.Label)</span><span class="@("kpi-icon "+metric.Tone)" aria-hidden="true"><WorkspaceIcon Name="@metric.Section" /></span></span>
                    <strong>@metric.Value</strong><span class="metric-bottom"><small>@T(metric.Detail)</small><span aria-hidden="true">↗</span></span>
                </button>
            }
        </div>
        <CommandSummary Russian="@(language=="ru")" Reservations="vehicleReservations" Fleet="fleet" Now="Now" Open="Navigate" />
        <section class="panel"><div class="registerhead"><div><h2>@T("Intelligent alerts")</h2><p class="muted">@T("Live rule-based review of current demo records.")</p></div><button class="secondary" @onclick='()=>Navigate("Notifications")'>@T("Open alert center")</button></div><FleetAlertList Russian="@(language=="ru")" Alerts="@(currentAlerts.Take(3).ToArray())" Open="Navigate"/></section>
        @if(dashboardPanels.Contains("trips")){
        <section class="panel recent-trips"><div class="registerhead"><div><h2>@T("Recent trips")</h2><p class="muted">@T("Latest eight trips by departure time.")</p></div><button class="secondary" @onclick='()=>Navigate("Dispatch")'>@T("View trip schedule")</button></div>@TripTable()</section>}
        @if(dashboardPanels.Contains("simulation")){
        <section class="panel simulation-showcase">
            <div class="simulation-copy"><span class="module-kicker">@T("Simulation workspace")</span><h2>@T("Interactive fleet visualization")</h2><p class="muted">@T("Inspect the illustrative 3D scene, then open the digital twin for actual simulated telemetry and incident scenarios.")</p><button class="secondary" @onclick='()=>Navigate("Digital Twin")'>@T("Open simulation") <span aria-hidden="true">↗</span></button></div>
            <FleetHeroScene Russian="@(language=="ru")" />
        </section>}
        @if(dashboardPanels.Contains("intelligence")){
        <section class="panel capability-panel"><div class="registerhead"><div><h2>@T("Explore intelligence")</h2><p class="muted">@T("Open a working laboratory with synthetic data and explainable results.")</p></div></div>
        <div class="capability-grid">
            @foreach(var tile in Capabilities){
                <button class="capability-card secondary" @onclick="()=>Navigate(tile.Section)"><span class="@("capability-art art-"+tile.Art)" aria-hidden="true"><span class="art-glyph"><WorkspaceIcon Name="@tile.Section"/></span></span><span class="capability-copy"><strong>@T(tile.Title)</strong><small>@T(tile.Description)</small><span class="capability-link">@T("Open module") <span aria-hidden="true">↗</span></span></span></button>
            }
        </div></section>}
        @if(dashboardPanels.Contains("guide")){
        <section class="panel"><h2>@T("Try a guided scenario")</h2><p class="muted">@T("All records are synthetic. Changes are stored only in this browser, so you can experiment safely.")</p>
        <div class="demojourney">
            <button class="secondary" @onclick='() => Navigate("Vehicles")'><strong>@T("01 · Register")</strong><small>@T("Add a vehicle and test search or validation.")</small></button>
            <button class="secondary" @onclick='() => Navigate("Dispatch")'><strong>@T("02 · Schedule")</strong><small>@T("Find a free vehicle and driver.")</small></button>
            <button class="secondary" @onclick='() => Navigate("Tracking")'><strong>@T("03 · Track")</strong><small>@T("Advance the simulated clock.")</small></button>
            <button class="secondary" @onclick='() => Navigate("Analytics")'><strong>@T("04 · Report")</strong><small>@T("Export an Excel workbook.")</small></button>
        </div></section>}
        @if(dashboardPanels.Contains("artwork")){
        <details class="panel design-gallery"><summary>@T("Design gallery")</summary><p class="muted">@T("Concept artwork and palette references — not live dashboard records.")</p><div class="design-gallery-grid"><figure><img src="assets/neon/ui-mockup.webp" alt="@T("Interface concept artwork")" loading="lazy" decoding="async" width="1200" height="675"/><figcaption>@T("Interface concept artwork")</figcaption></figure><figure><img src="assets/neon/style-board.webp" alt="@T("Neon design style board")" loading="lazy" decoding="async" width="1200" height="800"/><figcaption>@T("Neon design style board")</figcaption></figure></div></details>}
    }
    else if (section == "Vehicles" || section == "Drivers")
    {
        <FleetRegister @ref="activeRegister" Russian="@(language=="ru")" @key="(section,recordAction)" StartNew="@(newRecordSection==section)" Fleet="fleet" IsVehicles="@(section == "Vehicles")" Today="Now" Changed="Persist" OpenPassport="OpenPassport" MaintenanceEntries="maintenanceEntries" Shifts="driverShifts" Reservations="vehicleReservations" />
    }
    else if(section=="Notifications"){
        <NotificationCenter Russian="@(language=="ru")" Alerts="currentAlerts" Open="Navigate" Now="Now" />
    }
    else if(section=="Help & settings"){
        <section class="panel v4-help"><h2>@T("Help & settings")</h2><p class="muted">@T("Choose a workflow. Demo records stay in this browser; no live GPS or private server data is connected.")</p>
        <div class="formgrid"><label>@T("Appearance")<select aria-label="@T("Appearance")" @bind="themeMode" @bind:after="ApplyTheme"><option value="dark">@T("Dark")</option><option value="light">@T("Light")</option><option value="system">@T("System")</option></select></label><label>@T("Workspace visual style")<select aria-label="@T("Workspace visual style")" @bind="visualMode" @bind:after="PersistPreferences"><option value="premium">@T("Premium Violet")</option><option value="classic">@T("Classic workspace")</option></select></label><label>@T("Workspace density")<select aria-label="@T("Workspace density")" @bind="workspaceDensity" @bind:after="PersistPreferences"><option value="comfortable">@T("Comfortable")</option><option value="compact">@T("Compact")</option></select></label></div>
        <div class="help-grid">@foreach(var h in HelpItems){<button class="secondary" @onclick="()=>Navigate(h.Section)"><strong>@T(h.Section)</strong><small>@T(h.Description)</small></button>}</div>
        <p class="muted">@T("Use Ctrl+K to search modules. On mobile, use the bottom navigation or More.")</p>
        </section>
        <section class="panel suite-panel" aria-labelledby="snapshot-export-title"><div class="suite-heading"><div><span class="suite-kicker">@T("Local data portability")</span><h2 id="snapshot-export-title">@T("Export demo snapshot")</h2><p class="muted">@T("Download the current demo records and clock as JSON. This file may contain names, notes and registrations. No server upload, preferences or automatic restore.")</p></div><div class="actions"><button @onclick="ExportSnapshot">@T("Download demo JSON")</button><button class="secondary" @onclick="ExportSnapshotWorkbook">@T("Download snapshot Excel")</button></div></div><div class="metrics suite-metrics"><div class="metric">@T("Vehicles")<strong>@fleet.Vehicles.Count</strong></div><div class="metric">@T("Drivers")<strong>@fleet.Drivers.Count</strong></div><div class="metric">@T("Trips")<strong>@fleet.Trips.Count</strong></div></div>@if(snapshotFeedback.Length>0){<p role="status">@T(snapshotFeedback)</p>}</section>
        <SnapshotRestore Russian="@(language=="ru")" Restore="RestoreSnapshot"/>
    }
    else if (section == "Batch Dispatch")
    {
        <BatchDispatchView Russian="@(language=="ru")" Fleet="fleet" Now="Now" Shifts="driverShifts" Reservations="vehicleReservations" Enforce="requireShifts" Changed="Persist" Open="Navigate"/>
    }
    else if (section == "Resource Planning")
    {
        <ResourcePlanner Russian="@(language=="ru")" Fleet="fleet" Shifts="driverShifts" Now="Now" Enforce="requireShifts" EnforceChanged="SetRequireShifts" Changed="Persist" Open="Navigate"/>
    }
    else if (section == "Cost Intelligence")
    {
        <CostIntelligence Russian="@(language=="ru")" Fleet="fleet" MaintenanceEntries="maintenanceEntries" Now="Now" />
    }
    else if (section == "Demand Forecast")
    {
        <DemandForecastView Russian="@(language=="ru")" />
    }
    else if (section == "Vehicle Passport")
    {
        <VehiclePassportView Russian="@(language=="ru")" Fleet="fleet" MaintenanceEntries="maintenanceEntries" Now="Now" @bind-SelectedId="passportId" Open="Navigate" EditTrip="EditTrip" />
    }
    else if (section == "Data Quality")
    {
        <DataQualityView Russian="@(language=="ru")" />
    }
    else if (section == "Model Registry")
    {
        <RegistryView Russian="@(language=="ru")" />
    }
    else if (section == "Geo Map")
    {
        <GeoTrackingView Russian="@(language=="ru")" />
    }
    else if (section == "What-if")
    {
        <ScenarioLab Russian="@(language=="ru")" />
    }
    else if (section == "Multi Dispatch")
    {
        <MultiDispatchLab Russian="@(language=="ru")" />
    }
    else if (section == "Assistant")
    {
        <FleetAssistant Russian="@(language=="ru")" Fleet="fleet" Now="Now" Open="Navigate" Shifts="driverShifts" RequireShifts="requireShifts" Reservations="vehicleReservations" />
    }
    else if (section == "Digital Twin")
    {
        <DigitalTwinLab Russian="@(language=="ru")" />
    }
    else if (section == "Predictions")
    {
        <PredictionLab Russian="@(language=="ru")" />
    }
    else if (section == "Model Drift")
    {
        <DriftLab Russian="@(language=="ru")" />
    }
    else if (section == "Intelligence")
    {
        <IntelligenceLab Russian="@(language=="ru")" />
    }
    else if (section == "Optimization")
    {
        <RouteLab Russian="@(language=="ru")" />
    }
    else if (section == "Calendar")
    {
        <FleetCalendarView Russian="@(language=="ru")" Reservations="vehicleReservations" Fleet="fleet" Now="Now" EditTrip="EditTrip" PlanTrip="PlanFromCalendar" />
    }
    else if (section == "Analytics")
    {
        <FleetAnalytics Russian="@(language=="ru")" Fleet="fleet" Now="Now" />
    }
    else if (section == "Tracking")
    {
        <section class="panel"><h2>@T("Live fleet tracking")</h2><p class="muted">@T("Simulated positions on a schematic route network, not real GPS or geographic coordinates. Advance the simulation or select a trip.")</p>
            <div class="actions"><button @onclick="ToggleSimulation">@T(playing ? "Pause simulation" : "Play simulation")</button><button class="secondary" @onclick="Advance">@T("+ 15 minutes")</button><small>@T("Simulation time"): @Now.ToString("dd MMM · HH:mm")</small></div>
            <div class="split" style="margin-top:16px">
                <svg class="map" viewBox="0 0 600 340" role="img" aria-label="@T("Schematic routes and simulated vehicle positions")">
                    @for (int x = 30; x < 600; x+=45) { <line class="road" x1="@x" y1="0" x2="@x" y2="340"/> }
                    @for (int y = 30; y < 340; y+=45) { <line class="road" x1="0" y1="@y" x2="600" y2="@y"/> }
                    <path class="track" d="M110 55 L300 160"/><path class="track" d="M65 165 L535 105"/><path class="track" d="M300 160 L420 285"/>
                    <g fill="#fff" stroke="#6a5acd" stroke-width="2"><circle cx="110" cy="55" r="9"/><circle cx="300" cy="160" r="9"/><circle cx="65" cy="165" r="9"/><circle cx="535" cy="105" r="9"/><circle cx="420" cy="285" r="9"/></g>
                    <text x="120" y="45">@T("North depot")</text><text x="310" y="185">@T("Central hub")</text><text x="30" y="150">@T("West depot")</text><text x="465" y="85">@T("East terminal")</text><text x="430" y="310">@T("South depot")</text>
                    @foreach (var t in fleet.Trips.Where(t => t.Track is >= 0 and <= 2 && FleetRules.TripStatus(t, Now) == "In transit"))
                    {
                        var point=Position(t); <g><circle cx="@point.X" cy="@point.Y" r="@(selectedTrip==t.Id?13:9)" fill="#6a0dad" stroke="white" stroke-width="3"/><text x="@(point.X+15)" y="@(point.Y-10)">@VehicleName(t.VehicleId)</text></g>
                    }
                </svg>
                <div class="tripselect"><h3>@T("Trips")</h3>
                @foreach (var t in fleet.Trips.Where(t => t.Track >= 0)) { <button class="@(selectedTrip==t.Id?"":"secondary")" @onclick="()=>selectedTrip=t.Id">#@t.Id · @VehicleName(t.VehicleId)<br/><small style="color:inherit">@T(FleetRules.TripStatus(t,Now))</small></button> }
                @if (fleet.Trips.FirstOrDefault(t=>t.Id==selectedTrip) is Trip selected) {
                    <p>@selected.Origin → @selected.Destination<br/><small>@T("Progress"): @((FleetRules.Progress(selected,Now)*100).ToString("0"))% · @T("ETA") @selected.End.ToString("HH:mm")</small></p>
                    <div class="progress"><i style="width:@((FleetRules.Progress(selected,Now)*100).ToString("0",CultureInfo.InvariantCulture) + "%")"></i></div>
                }
                </div>
            </div>
        </section>
    }
    else if (section == "Dispatch")
    {
        <section class="panel"><h2>@T("Intelligent dispatch planner")</h2>@if (editingTripId.HasValue) { <p class="notice">@T("Editing trip") #@editingTripId</p> }<p class="muted">@T("Find an available vehicle and driver. The C# scheduler checks overlapping assignments and reservations, and avoids vehicles with overdue service when recommending a pair.") @T(requireShifts?"Strict shift coverage is enabled.":"Shift coverage is advisory.")</p>
        <div class="formgrid">
            <label>@T("Origin")<input @bind="origin" @bind:event="oninput" @bind:after="MarkTripDirty" /></label><label>@T("Destination")<input @bind="destination" @bind:event="oninput" @bind:after="MarkTripDirty" /></label><label>@T("Distance (km)")<input type="number" min="1" @bind="distance" @bind:after="MarkTripDirty" /></label>
            <label>@T("Start")<input type="datetime-local" @bind="start" @bind:after="MarkTripDirty" /></label><label>@T("End")<input type="datetime-local" @bind="end" @bind:after="MarkTripDirty" /></label>
            <label>@T("Vehicle")<select @bind="vehicleId" @bind:after="MarkTripDirty"><option value="0">@T("Select vehicle")</option>@foreach(var v in fleet.Vehicles){<option value="@v.Id">@v.Plate · @v.Model</option>}</select></label>
            <label>@T("Driver")<select @bind="driverId" @bind:after="MarkTripDirty"><option value="0">@T("Select driver")</option>@foreach(var d in fleet.Drivers){<option value="@d.Id">@d.Name</option>}</select></label>
        </div>
        <div class="actions"><button class="secondary" @onclick="Recommend">@T("Suggest assignment")</button><button @onclick="SaveTrip" disabled="@(tripSaving || fleet.Vehicles.Count == 0 || fleet.Drivers.Count == 0)">@T(editingTripId.HasValue ? "Save changes" : "Create trip")</button>@if(editingTripId.HasValue||tripDirty){<button class="secondary" @onclick="CancelTripAction">@T(editingTripId.HasValue?"Cancel edit":"Cancel")</button>}</div>
        @if(!string.IsNullOrEmpty(feedback)){<p role="status" class="@(isError?"error":"notice")">@T(feedback)</p>}
