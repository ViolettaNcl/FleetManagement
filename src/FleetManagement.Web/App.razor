    private void OpenPassport(int id){passportId=id;Navigate("Vehicle Passport");}
    private void Navigate(string item){if(section!=item){if(!CanLeaveRegister()||!CanDiscardTrip())return;if(section=="Dispatch")CancelEdit();}NavigateCore(item);}
    private void NavigateCore(string item){if(section!=item){newRecordSection="";writeHistory=true;recent.Remove(item);recent.Insert(0,item);if(recent.Count>5)recent.RemoveAt(5);recentDirty=true;}mobileNav=false;quickActionsExpanded=false;navQuery="";focusContent=true;if(item=="Vehicle Passport"&&!fleet.Vehicles.Any(v=>v.Id==passportId))passportId=fleet.Vehicles.FirstOrDefault()?.Id??0;section=item;feedback="";if(item=="Dispatch"){if(!fleet.Vehicles.Any(v=>v.Id==vehicleId))vehicleId=fleet.Vehicles.FirstOrDefault()?.Id??0;if(!fleet.Drivers.Any(d=>d.Id==driverId))driverId=fleet.Drivers.FirstOrDefault()?.Id??0;}}
    private async Task ToggleSimulation(){playing=!playing;if(!playing)await Persist();}
    private async Task Advance(){Now=Now.AddMinutes(15);await Persist();}
    private async Task Reset(){if(!await JS.InvokeAsync<bool>("confirm",T("Reset all demo data?")))return;ClearTripFilters();recordAction++;newRecordSection="";playing=false;Now=DateTime.Now;fleet=FleetRules.Sample(Now);maintenanceEntries.Clear();driverShifts.Clear();vehicleReservations.Clear();requireShifts=false;maintenanceFeedback="";start=Now.AddHours(1);end=Now.AddHours(2);vehicleId=driverId=1;selectedTrip=101;editingTripId=null;tripDirty=false;feedback="";await Persist();}
    private string VehicleName(int id)=>fleet.Vehicles.FirstOrDefault(v=>v.Id==id)?.Plate??"Unknown";
    private string DriverName(int id)=>fleet.Drivers.FirstOrDefault(d=>d.Id==id)?.Name??"Unknown";
    private async Task SetRequireShifts(bool value){requireShifts=value;await Persist();}
    private void Recommend(){var a=ResourcePlanning.Recommend(fleet,start,end,Now,driverShifts,requireShifts,editingTripId,vehicleReservations);isError=a is null;if(a is null){feedback="No available service-ready assignment for this interval.";return;}vehicleId=a.VehicleId;driverId=a.DriverId;MarkTripDirty();feedback=language=="ru"?$"Рекомендуем {VehicleName(vehicleId)} и {DriverName(driverId)}.":$"Suggested {VehicleName(vehicleId)} and {DriverName(driverId)}.";}
    private void EditTrip(Trip trip){if(!CanDiscardTrip())return;if(FleetRules.CanChangeTrip(fleet,trip.Id,Now) is string invalid){feedback=invalid;isError=true;return;}editingTripId=trip.Id;origin=trip.Origin;destination=trip.Destination;distance=trip.Distance;start=trip.Start;end=trip.End;vehicleId=trip.VehicleId;driverId=trip.DriverId;feedback="";tripDirty=false;NavigateCore("Dispatch");}
    private void PlanFromCalendar(DateTime date){CancelEdit();start=date.Date.AddHours(9);if(start<=Now)start=Now.AddHours(1);end=start.AddHours(1);NavigateCore("Dispatch");}
    private void CancelEdit(){tripDirty=false;editingTripId=null;origin="North depot";destination="Central hub";distance=132;start=Now.AddHours(1);end=Now.AddHours(2);feedback="";}
    private async Task DeleteTrip(Trip trip){if(FleetRules.CanChangeTrip(fleet,trip.Id,Now) is string invalid){feedback=invalid;isError=true;return;}if(!await JS.InvokeAsync<bool>("confirm",language=="ru"?$"Удалить запланированный рейс #{trip.Id}?":$"Delete scheduled trip #{trip.Id}?"))return;fleet.Trips.RemoveAll(t=>t.Id==trip.Id);if(editingTripId==trip.Id)CancelEdit();feedback=language=="ru"?$"Рейс #{trip.Id} удалён.":$"Trip #{trip.Id} deleted.";isError=false;await Persist();}
    private async Task SaveTrip(){if(tripSaving)return;tripSaving=true;try{await SaveTripCore();}finally{tripSaving=false;}}
    private async Task SaveTripCore(){
        if(editingTripId is int existingId && FleetRules.CanChangeTrip(fleet,existingId,Now) is string invalid){feedback=invalid;isError=true;return;}
        if(start<=Now){feedback="A new or edited trip must start in the future.";isError=true;return;}
        var id=editingTripId??fleet.Trips.Select(t=>t.Id).DefaultIfEmpty(100).Max()+1;
        var old=fleet.Trips.FirstOrDefault(t=>t.Id==id);
        var track=old is not null && old.Origin==origin.Trim() && old.Destination==destination.Trim()?old.Track:-1;
        var trip=new Trip(id,vehicleId,driverId,origin.Trim(),destination.Trim(),start,end,distance,track);
        var error=ResourcePlanning.ValidateTrip(fleet,trip,driverShifts,requireShifts,vehicleReservations);isError=error is not null;if(error is not null){feedback=error;return;}
        if(old is null)fleet.Trips.Add(trip);else fleet.Trips[fleet.Trips.FindIndex(t=>t.Id==id)]=trip;
        CancelEdit();feedback=language=="ru"?$"Рейс #{id} сохранён.":$"Trip #{id} saved.";await Persist();
    }
    private async Task RecordService(int id){var error=MaintenanceJournal.Record(fleet,maintenanceEntries,new(id,"Scheduled service","",null),Now);maintenanceFeedback=error??"Service recorded; cost unknown.";if(error is null)await Persist();}
    private (int X,int Y) Position(Trip t){var p=FleetRules.Progress(t,Now);var (x1,y1,x2,y2)=t.Track switch{0=>(110,55,300,160),1=>(65,165,535,105),_=>(300,160,420,285)};return ((int)(x1+(x2-x1)*p),(int)(y1+(y2-y1)*p));}
    private string tripQuery="",tripStatus="";private int tripPage,tripPageSize=10;
    private void ResetTripPage()=>tripPage=0;
    private int TripPageCount=>Math.Max(1,(FilteredTrips().Count()+tripPageSize-1)/tripPageSize);
    private int CurrentTripPage=>Math.Clamp(tripPage,0,TripPageCount-1);
    private IEnumerable<Trip> VisibleTrips()=>section=="Dispatch"?FilteredTrips().Skip(CurrentTripPage*tripPageSize).Take(tripPageSize):FilteredTrips();
    private void ClearTripFilters(){tripQuery="";tripStatus="";ResetTripPage();}

    private IEnumerable<Trip> FilteredTrips(){var rows=fleet.Trips.OrderByDescending(t=>t.Start).AsEnumerable();if(section!="Dispatch")return rows.Take(8);var q=tripQuery.Trim();return rows.Where(t=>(tripStatus.Length==0||FleetRules.TripStatus(t,Now)==tripStatus)&&(q.Length==0||new[]{t.Id.ToString(CultureInfo.InvariantCulture),t.Origin,t.Destination,VehicleName(t.VehicleId),DriverName(t.DriverId)}.Any(x=>x.Contains(q,StringComparison.OrdinalIgnoreCase))));}
    private RenderFragment TripTable()=> @<div class="trip-results"><div class="tablewrap trip-table" tabindex="0" role="region" aria-label="@T("Trip schedule")"><table><thead><tr><th>@T("Trip")</th><th>@T("Route")</th><th>@T("Vehicle")</th><th>@T("Driver")</th><th>@T("Start")</th><th>@T("End")</th><th>@T("Distance")</th><th>@T("Status")</th>@if(section=="Dispatch"){<th>@T("Actions")</th>}</tr></thead><tbody>
    @if(!FilteredTrips().Any()){<tr><td colspan="@(section=="Dispatch"?9:8)" class="empty-state">@T("No matching trips.")</td></tr>}
    @foreach(var t in VisibleTrips()){var status=FleetRules.TripStatus(t,Now);<tr><td>#@t.Id</td><td>@t.Origin → @t.Destination</td><td>@VehicleName(t.VehicleId)</td><td>@DriverName(t.DriverId)</td><td>@t.Start.ToString("dd MMM HH:mm")</td><td>@t.End.ToString("dd MMM HH:mm")</td><td>@t.Distance km</td><td><span class="pill @status.Replace(" ","").ToLowerInvariant()">@T(status)</span></td>@if(section=="Dispatch"){<td>@if(status=="Scheduled"){<div class="actions"><button class="secondary" @onclick="()=>EditTrip(t)">@T("Edit")</button><button class="delete" @onclick="()=>DeleteTrip(t)">@T("Delete")</button></div>}else{<small>@T("History")</small>}</td>}</tr>}
    </tbody></table></div>
    <div class="register-cards trip-cards">
    @foreach(var t in VisibleTrips()){
      var status=FleetRules.TripStatus(t,Now);
      <article class="register-record" @key="t.Id"><div class="record-heading"><div><strong>@t.Origin → @t.Destination</strong><small>@T("Trip") #@t.Id</small></div><span class="pill @status.Replace(" ","").ToLowerInvariant()">@T(status)</span></div>
      <dl><div><dt>@T("Vehicle")</dt><dd>@VehicleName(t.VehicleId)</dd></div><div><dt>@T("Driver")</dt><dd>@DriverName(t.DriverId)</dd></div><div><dt>@T("Start")</dt><dd>@t.Start.ToString("dd MMM HH:mm")</dd></div><div><dt>@T("End")</dt><dd>@t.End.ToString("dd MMM HH:mm")</dd></div><div><dt>@T("Distance")</dt><dd>@t.Distance km</dd></div></dl>
      @if(section=="Dispatch"&&status=="Scheduled"){<div class="record-actions"><button class="secondary" @onclick="()=>EditTrip(t)">@T("Edit")</button><button class="delete" @onclick="()=>DeleteTrip(t)">@T("Delete")</button></div>}</article>
    }
    @if(!FilteredTrips().Any()){<p class="empty-state">@T("No matching trips.")</p>}
    </div>
    @if(section=="Dispatch"){<WorkspacePager Russian="@(language=="ru")" Page="CurrentTripPage" PageCount="TripPageCount" PageSize="tripPageSize" PageChanged="@(p=>tripPage=p)" SizeChanged="@(n=>{tripPageSize=n;ResetTripPage();})" />}
    </div>;
    public async ValueTask DisposeAsync(){try{await JS.InvokeVoidAsync("fleetDisposeNavigation");}catch(JSException){}self?.Dispose();cts.Cancel();timer?.Dispose();if(timerTask is not null)await timerTask;cts.Dispose();}
}
