@using FleetManagement.Web
@{
    var statusCounts=Fleet.Trips.GroupBy(t=>FleetRules.TripStatus(t,Now)).ToDictionary(g=>g.Key,g=>g.Count());
    var serviceCounts=Fleet.Vehicles.GroupBy(v=>FleetRules.Assess(v,Now).Status).ToDictionary(g=>g.Key,g=>g.Count());
    var activeIds=Fleet.Trips.Where(t=>t.Start<=Now&&Now<t.End).Select(t=>t.VehicleId).ToHashSet();
    var reservedIds=Reservations.Where(r=>r.Start<=Now&&Now<r.End).Select(r=>r.VehicleId).ToHashSet();
    var available=Fleet.Vehicles.Count(v=>!activeIds.Contains(v.Id)&&!reservedIds.Contains(v.Id)&&FleetRules.Assess(v,Now).Status!="Due");
}
<div class="split command-summary">
    <section class="panel workload-panel">
        <div class="registerhead"><div><h2>@T("Fleet workload")</h2><p class="muted">@T("Current register") · @Now.ToString("dd MMM yyyy HH:mm")</p></div><button class="secondary" @onclick='()=>Open.InvokeAsync("Analytics")'>@T("View analytics")</button></div>
        <img class="enterprise-command-image" src="assets/heroes/command-center.webp" alt="" loading="lazy" decoding="async" /><div class="workload-overview">
            <div class="workload-donut" style="@DonutStyle(statusCounts)" role="img" aria-label="@WorkloadLabel(statusCounts)"><div><strong>@Fleet.Trips.Count</strong><small>@T("Total trips")</small></div></div>
            <div class="workload-legend">
                @foreach(var status in new[]{"In transit","Scheduled","Completed"}){
                    var number=statusCounts.GetValueOrDefault(status);
                    var share=Percent(number,Fleet.Trips.Count);
                    <button type="button" class="secondary workload-row workload-filter" data-trip-status="@status" aria-describedby="workload-filter-description" @onclick="()=>FilterTrips.InvokeAsync(status)">
                        <span class="@("chart-dot "+Tone(status))" aria-hidden="true"></span>
                        <span>@T(status)</span>
                        <strong>@number</strong>
                        <small>@share</small>
                    </button>
                }
            </div>
        </div>
        <p id="workload-filter-description" class="muted">@T("Select a status to show matching trips.")</p>
        <div class="availability-summary"><div><strong data-testid="available-now">@available <small>/ @Fleet.Vehicles.Count</small></strong><span>@T("Vehicles available now")</span></div><p class="muted">@T("No active trip, current reservation or overdue service. Future assignments still require validation.")</p><button class="secondary" @onclick='()=>Open.InvokeAsync("Dispatch")'>@T("Open dispatch")</button></div><div class="readiness-section"><h3>@T("Maintenance readiness")</h3>
        @foreach(var status in new[]{"Healthy","Soon","Due"}){
            var number=serviceCounts.GetValueOrDefault(status);
            <div class="reportbar readiness-bar"><div><span>@T(status)</span><strong>@number / @Fleet.Vehicles.Count</strong></div><div class="progress"><i class="@Tone(status)" style="@Width(number,Fleet.Vehicles.Count)"></i></div></div>
        }
        <p class="muted">@T("Configured service intervals, not mechanical safety certification.")</p></div>
    </section>
    <section class="panel agenda-panel"><div class="registerhead"><div><h2>@T("Today's agenda")</h2><p class="muted">@T("Trips, vehicle reservations and date-based service reminders.")</p></div><button class="secondary" @onclick='()=>Open.InvokeAsync("Calendar")'>@T("Full calendar")</button></div>
        @{var entries=FleetCalendar.Entries(Fleet,Now.Date,Now.Date.AddDays(1),Reservations);}
        <div class="agenda-date"><strong>@Now.ToString("dd")</strong><div><span>@Now.ToString("MM / yyyy",CultureInfo.InvariantCulture)</span><small>@entries.Count @T("Scheduled events")</small></div></div>
        @if(entries.Count==0){<p class="empty-state">@T("No events today.")</p>}
        @foreach(var entry in entries.Take(6)){
            <div class="command-event"><span class="calendar-chip @(entry.Kind=="Trip"?"trip":"service")">@(entry.Kind=="Service due"?T("Service due"):entry.Start.ToString("HH:mm"))</span><div><strong>@entry.Title · @T(entry.Kind)</strong><p class="muted">@T(entry.Detail)</p></div></div>
        }
        @if(entries.Count>6){<p class="muted">+ @(entries.Count-6) @T("More events in calendar")</p>}
    </section>
</div>
@code{
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    [Parameter,EditorRequired] public FleetData Fleet{get;set;}=default!;
    [Parameter] public DateTime Now{get;set;}
    [Parameter] public IReadOnlyList<VehicleReservation> Reservations{get;set;}=[];
    [Parameter] public EventCallback<string> Open{get;set;}
    [Parameter] public EventCallback<string> FilterTrips{get;set;}
    private static string Tone(string status)=>status switch{"In transit"=>"violet","Scheduled"=>"cyan","Completed" or "Healthy"=>"green","Soon"=>"amber",_=>"red"};
    private static double Share(int count,int total)=>total==0?0:100.0*count/total;
    private static string F(double n)=>n.ToString("F3",CultureInfo.InvariantCulture);
    private static string Percent(int count,int total)=>Share(count,total).ToString("F0",CultureInfo.InvariantCulture)+"%";
    private static string Width(int count,int total)=>"width:"+F(Share(count,total))+"%";
    private string DonutStyle(IReadOnlyDictionary<string,int> counts){if(Fleet.Trips.Count==0)return "background:var(--line)";var a=Share(counts.GetValueOrDefault("In transit"),Fleet.Trips.Count);var b=a+Share(counts.GetValueOrDefault("Scheduled"),Fleet.Trips.Count);return $"background:conic-gradient(var(--chart-violet) 0 {F(a)}%,var(--chart-cyan) {F(a)}% {F(b)}%,var(--chart-green) {F(b)}% 100%)";}
    private string WorkloadLabel(IReadOnlyDictionary<string,int> counts)=>string.Join(", ",new[]{"In transit","Scheduled","Completed"}.Select(s=>$"{T(s)}: {counts.GetValueOrDefault(s)}"));
}
