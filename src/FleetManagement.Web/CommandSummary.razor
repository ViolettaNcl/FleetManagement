<div class="split command-summary">
    <section class="panel"><div class="registerhead"><div><h2>Fleet workload</h2><p class="muted">Current register · @Now.ToString("dd MMM yyyy HH:mm")</p></div><button class="secondary" @onclick='()=>Open.InvokeAsync("Analytics")'>View analytics</button></div>
        @foreach(var status in new[]{"In transit","Scheduled","Completed"}){
            var number=Fleet.Trips.Count(t=>FleetRules.TripStatus(t,Now)==status);
            <div class="reportbar"><div><strong>@status</strong><span>@number</span></div><div class="progress"><i style="@Width(number,Fleet.Trips.Count)"></i></div></div>
        }
        <h3>Maintenance readiness</h3>
        @foreach(var status in new[]{"Healthy","Soon","Due"}){
            var number=Fleet.Vehicles.Count(v=>FleetRules.Assess(v,Now).Status==status);
            <div class="reportbar"><div><strong>@status</strong><span>@number</span></div><div class="progress"><i style="@Width(number,Fleet.Vehicles.Count)"></i></div></div>
        }
        <p class="muted">Configured service intervals, not mechanical safety certification.</p>
    </section>
    <section class="panel"><div class="registerhead"><div><h2>Today's agenda</h2><p class="muted">Trips overlapping the demo day and date-based service reminders.</p></div><button class="secondary" @onclick='()=>Open.InvokeAsync("Calendar")'>Full calendar</button></div>
        @{var entries=FleetCalendar.Entries(Fleet,Now.Date,Now.Date.AddDays(1));}
        @if(entries.Count==0){<p>No events today.</p>}
        @foreach(var entry in entries.Take(6)){
            <div class="command-event"><span class="calendar-chip @(entry.Kind=="Trip"?"trip":"service")">@(entry.Kind=="Trip"?entry.Start.ToString("HH:mm"):"Service due")</span><div><strong>@entry.Title</strong><p class="muted">@entry.Detail</p></div></div>
        }
        @if(entries.Count>6){<p class="muted">+ @(entries.Count-6) more events in calendar.</p>}
    </section>
</div>
@code{
    [Parameter,EditorRequired] public FleetData Fleet{get;set;}=default!;
    [Parameter] public DateTime Now{get;set;}
    [Parameter] public EventCallback<string> Open{get;set;}
    private static string Width(int count,int total)=>"width:"+(total==0?0:100.0*count/total).ToString("F2",CultureInfo.InvariantCulture)+"%";
}
