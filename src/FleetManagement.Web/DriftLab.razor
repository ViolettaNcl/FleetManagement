@using FleetManagement.Web
<section class="panel"><h2>@T("Model drift laboratory")</h2><p class="muted">@T("Compare a synthetic reference window with an independent held-out vehicle window. Inject a sensor-distribution shift without changing the trained model. This is a covariate drift demonstration, not observed failures or model accuracy monitoring.")</p><div class="formgrid"><label>@T("Drift seed")<input type="number" @bind="seed"/></label><label>@T("Injected shift (0–100%)")<input type="number" min="0" max="100" step="10" @bind="intensity"/></label></div><button @onclick="Run">@T("Compare drift windows")</button>@if(message.Length>0){<p role="status" class="notice">@T(message)</p>}</section>
@if(report is not null&&control is not null){
    <div class="metrics"><div class="metric">@T("Reference rows")<strong>@report.ReferenceRows</strong></div><div class="metric">@T("Monitoring rows")<strong>@report.CurrentRows</strong></div><div class="metric">@T("High PSI features")<strong>@report.Features.Count(f=>f.Level=="High")</strong></div><div class="metric">@T("Mean predicted risk")<strong>@report.CurrentMeanRisk.ToString("P1")</strong></div></div>
    <section class="panel"><h2>@T("Population stability index (PSI)")</h2><p class="muted">@T("Reference quantile bins with smoothed proportions. Watch ≥ 0.10; High ≥ 0.25 are illustrative heuristics, not statistical guarantees. Control and shifted windows use the same held-out samples.")</p><div class="tablewrap" role="region" tabindex="0" aria-label="@T("Feature drift")"><table><thead><tr><th>@T("Feature")</th><th>@T("Reference mean")</th><th>@T("Shifted mean")</th><th>@T("Control PSI")</th><th>@T("Shifted PSI")</th><th>@T("Signal")</th></tr></thead><tbody>@for(int i=0;i<report.Features.Count;i++){var f=report.Features[i];<tr><td>@T(f.Name)</td><td>@f.ReferenceMean.ToString("F2")</td><td>@f.CurrentMean.ToString("F2")</td><td>@control.Features[i].Psi.ToString("F3")</td><td>@f.Psi.ToString("F3")</td><td>@T(f.Level)</td></tr>}</tbody></table></div>
    <h3>@T("Average model output")</h3><p>@T("Reference") @report.ReferenceMeanRisk.ToString("P1") · @T("Control") @control.CurrentMeanRisk.ToString("P1") · @T("Shifted") @report.CurrentMeanRisk.ToString("P1")</p><p class="muted">@T("Risk changes are model outputs under hypothetical sensor changes, not observed failure rates. Investigate data quality and collect labels before evaluating performance or retraining. No automatic promotion.")</p></section>
}
<section class="panel"><h2>@T("Retraining candidate review")</h2><p class="muted">@T("Train three fixed configurations on the original synthetic training cohort, rank by validation Brier loss, then evaluate the selected candidate and 120-epoch incumbent on a separate synthetic cohort. No automatic deployment or replacement.")</p><button @onclick="Review">@T("Run retraining review")</button>
@if(review is not null){
    <div class="metrics"><div class="metric">@T("Training rows")<strong>@review.TrainRows</strong></div><div class="metric">@T("Validation rows")<strong>@review.ValidationRows</strong></div><div class="metric">@T("Final evaluation rows")<strong>@review.EvaluationRows</strong></div><div class="metric">@T("Selected epochs")<strong>@review.SelectedEpochs</strong></div></div>
    <div class="tablewrap" role="region" tabindex="0" aria-label="@T("Validation threshold comparison")"><table><thead><tr><th>@T("Epochs")</th><th>@T("Validation Brier")</th><th>@T("Validation F1")</th></tr></thead><tbody>@foreach(var c in review.Candidates){<tr><td>@c.Epochs</td><td>@c.Validation.Brier.ToString("F4")</td><td>@c.Validation.F1.ToString("P1")</td></tr>}</tbody></table></div>
    <h3>@T("Independent candidate evaluation")</h3><p>@T("Incumbent") Brier @review.IncumbentEvaluation.Brier.ToString("F4") · @T("Selected") Brier @review.CandidateEvaluation.Brier.ToString("F4")</p><p>@T("Incumbent") F1 @review.IncumbentEvaluation.F1.ToString("P1") · @T("Selected") F1 @review.CandidateEvaluation.F1.ToString("P1")</p><p class="muted">@T("Candidate selection does not guarantee improvement on final evaluation. Review representative labelled data and operational thresholds before considering a real deployment. Current experiment remains unchanged.")</p>
}</section>
@code{
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    private RetrainingResult? review;
    private void Review()=>review=RetrainingReview.Run(seed);
    private int seed=42,intensity=100;
    private DriftReport? report,control;
    private string message="";
    private void Run(){
        if(intensity is <0 or >100){message="Choose a shift from 0 to 100.";return;}
        var reference=MaintenanceLearning.Generate(seed,0,40,60).Select(r=>r.Features).ToArray();
        var current=MaintenanceLearning.Generate(unchecked(seed^0x5A17),1000,12,60).Select(r=>r.Features).ToArray();
        var model=MaintenanceLearning.Train(seed).Model;
        control=ModelDrift.Compare(reference,current,model);
        report=ModelDrift.Compare(reference,current.Select(x=>ModelDrift.Shift(x,intensity/100.0)).ToArray(),model);
        message="Drift comparison complete.";
    }
}
