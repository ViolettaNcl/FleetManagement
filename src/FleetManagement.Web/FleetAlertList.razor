@if(Alerts.Count==0){<p class="muted">@T("No matching alerts. This does not certify vehicle safety.")</p>}
else{
    <div class="advisor-list">
    @foreach(var item in Alerts){
        <article class="advisor-alert">
            <div><span class="pill @(item.Severity=="High"?"due":"soon")">@T(item.Severity)</span> <strong>@item.Subject · @item.Title</strong></div>
            <p>@item.Evidence</p><p class="muted">@item.Recommendation</p>
            @if(Open.HasDelegate){<button class="secondary" @onclick="()=>Open.InvokeAsync(item.Destination)">@(Russian?"Открыть ":"Open ")@T(item.Destination)</button>}
        </article>
    }
    </div>
}
@code{
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    [Parameter,EditorRequired] public IReadOnlyList<FleetAlert> Alerts{get;set;}=[];
    [Parameter] public EventCallback<string> Open{get;set;}
}
