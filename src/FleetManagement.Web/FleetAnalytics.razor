@using FleetManagement.Web
@inject IJSRuntime JS
<section class="panel">
    <div class="registerhead"><div><h2>@T("Fleet analytics")</h2><p class="muted">@T("Trip cohort by departure date. Completed distance counts only finished trips. Service health reflects simulation time.")</p></div><button @onclick="Export" disabled="@(!Valid)">@T("Export Excel (.xlsx)")</button></div>
    <div class="actions registertools">
        <label>@T("From")<input type="date" @bind="from" /></label>
        <label>@T("To")<input type="date" @bind="to" /></label>
        <button class="secondary" @onclick="Last30">@T("Last 30 days")</button>
    </div>
    @if(!Valid){<p class="error" role="status">@T("Choose a valid date range of up to 366 calendar days.")</p>}
    @if(!string.IsNullOrEmpty(feedback)){<p class="notice" role="status">@T(feedback)</p>}
</section>
@if(Valid)
{
    var data=FleetReport.Build(Fleet,Now,from,to);
    <div class="metrics">
        <div class="metric">@T("Trips")<strong>@data.Trips</strong></div>
        <div class="metric">@T("Completed")<strong>@data.Completed</strong></div>
        <div class="metric">@T("Completed distance")<strong>@data.CompletedDistanceKm.ToString("N0") <small>km</small></strong></div>
        <div class="metric">@T("Service due")<strong>@data.ServiceDue</strong></div>
    </div>
    <section class="panel analytics-trend">
        <div class="registerhead"><div><h2>@T("Trip activity by period")</h2><p class="muted">@T("Actual trips in the selected departure-date cohort. Zero periods are retained.")</p></div><span class="pill">@data.Trips @T("Trips")</span></div>
        @{var periods=FleetReport.Periods(Fleet,Now,from,to);var maximum=Math.Max(1,periods.Max(p=>p.Trips));}
        <div class="trend-legend"><span><i class="chart-dot violet"></i>@T("Trips")</span><span><i class="chart-dot green"></i>@T("Completed")</span></div>
        <div class="trend-scroll" tabindex="0" role="region" aria-label="@T("Trip activity by period")"><div class="trend-grid">
        @foreach(var period in periods){
            <div class="trend-period" data-testid="trip-period" data-trips="@period.Trips" data-completed="@period.Completed">
                <span class="trend-total">@period.Trips</span>
                <div class="trend-track" role="img" aria-label="@($"{period.From:dd MMM} – {period.To:dd MMM}: {T("Trips")} {period.Trips}, {T("Completed")} {period.Completed}")">
                    <div class="trend-bar" style="@("height:"+Percent(period.Trips,maximum))"><div class="trend-done" style="@("height:"+Percent(period.Completed,period.Trips))"></div></div>
                </div>
                <small>@period.From.ToString("dd MMM")</small>
            </div>
        }
        </div></div>
    </section>
    <PeriodComparisonView Russian="Russian" Comparison="@FleetReport.ComparePrevious(Fleet,Now,from,to)"/>
    <div class="split">
        <section class="panel"><h2>@T("Distance by vehicle")</h2><p class="muted">@T("Completed trips only · km") · @T("Top 10 vehicles")</p>
            @{var maximumDistance=data.VehicleRows.Select(r=>r.CompletedDistanceKm).DefaultIfEmpty(0).Max();}
            @foreach(var row in data.VehicleRows.OrderByDescending(v=>v.CompletedDistanceKm).ThenBy(v=>v.Registration,StringComparer.Ordinal).Take(10)){
                <div class="reportbar"><div><strong>@row.Registration</strong><span>@row.CompletedDistanceKm.ToString("N0") km</span></div><div class="progress"><i style="@BarStyle(row.CompletedDistanceKm,maximumDistance)"></i></div></div>
            }
            @if(data.VehicleRows.Count==0){<p>@T("No vehicles registered.")</p>}
        </section>
        <section class="panel"><h2>@T("Trip status")</h2>
            <div class="reportbar"><div><strong>@T("Completed")</strong><span>@data.Completed</span></div><div class="progress"><i style="@BarStyle(data.Completed,data.Trips)"></i></div></div>
            <div class="reportbar"><div><strong>@T("In transit")</strong><span>@data.Active</span></div><div class="progress"><i style="@BarStyle(data.Active,data.Trips)"></i></div></div>
            <div class="reportbar"><div><strong>@T("Scheduled")</strong><span>@data.Scheduled</span></div><div class="progress"><i style="@BarStyle(data.Scheduled,data.Trips)"></i></div></div>
            <p class="muted">@T("Service due"): @data.ServiceDue · @T("Service soon"): @data.ServiceSoon</p>
        </section>
    </div>
    <section class="panel"><h2>@T("Vehicle performance")</h2><div class="tablewrap"><table><thead><tr><th>@T("Registration")</th><th>@T("Model")</th><th>@T("Trips")</th><th>@T("Completed")</th><th>@T("Completed distance")</th><th>@T("Service")</th></tr></thead><tbody>
        @foreach(var row in data.VehicleRows){<tr><td>@row.Registration</td><td>@row.Model</td><td>@row.Trips</td><td>@row.CompletedTrips</td><td>@row.CompletedDistanceKm km</td><td><span class="pill @row.ServiceStatus.ToLowerInvariant()">@T(row.ServiceStatus)</span></td></tr>}
    </tbody></table></div></section>
    <VehicleReportBuilder Russian="Russian" Summary="data" From="from" To="to"/>
}
@code{
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    [Parameter, EditorRequired] public FleetData Fleet {get;set;}=default!;
    [Parameter] public DateTime Now {get;set;}
    private DateTime from,to;
    private string feedback="";
    private bool Valid=>FleetReport.ValidRange(from,to);
    protected override void OnInitialized()=>Last30();
    private void Last30(){from=Now.Date.AddDays(-29);to=Now.Date;feedback="";}
    private static string Percent(int value,int total)=>(total==0?0:100.0*value/total).ToString("0.##",CultureInfo.InvariantCulture)+"%";
    private static string BarStyle(long value,long max)=>"width:"+(max==0?0:100.0*value/max).ToString("0.##",CultureInfo.InvariantCulture)+"%";
    private async Task Export(){
        if(!Valid)return;
        try{
            var bytes=FleetReport.ExportXlsx(FleetReport.Build(Fleet,Now,from,to),from,to,Russian);
            await JS.InvokeVoidAsync("fleetDownload",Convert.ToBase64String(bytes),$"fleet-report-{from:yyyy-MM-dd}-{to:yyyy-MM-dd}.xlsx");
            feedback="Excel workbook generated.";
        }catch(JSException){feedback="Unable to download the workbook in this browser.";}
    }
}
