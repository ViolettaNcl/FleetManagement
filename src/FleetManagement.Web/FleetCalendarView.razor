@using FleetManagement.Web
@using System.Globalization
<section class="panel calendar-panel">
    <div class="registerhead">
        <div><h2>@T("Fleet calendar")</h2><p class="muted">@T("Trip schedule, vehicle reservations and calendar-based service deadlines. Deadlines alone do not reserve vehicles.")</p></div>
        <button @onclick="NewTrip">@T("+ Plan trip")</button>
    </div>
    <div class="actions calendar-toolbar">
        <button class="secondary" aria-label="@T("Previous period")" @onclick="()=>Move(-1)">‹</button>
        <button class="secondary" @onclick="Today">@T("Today")</button>
        <button class="secondary" aria-label="@T("Next period")" @onclick="()=>Move(1)">›</button>
        <strong>@Heading</strong>
        <div class="actions">
            @foreach(var v in Views){<button class="@(view==v?"":"secondary")" aria-pressed="@(view==v?"true":"false")" @onclick="()=>view=v">@T(v)</button>}
        </div>
    </div>
    <div class="actions registertools">
        <label>@T("Vehicle")<select aria-label="@T("Vehicle")" @bind="vehicleId"><option value="0">@T("All vehicles")</option>@foreach(var v in Fleet.Vehicles){<option value="@v.Id">@v.Plate</option>}</select></label>
        <label>@T("Event type")<select aria-label="@T("Event type")" @bind="kind"><option value="All">@T("All events")</option><option value="Trip">@T("Trips")</option><option value="Service due">@T("Service deadlines")</option><option value="Reservation">@T("Vehicle reservations")</option></select></label>
    </div>
    <div class="calendar-legend"><span><i class="calendar-dot trip" aria-hidden="true"></i>@T("Trips")</span><span><i class="calendar-dot service" aria-hidden="true"></i>@T("Service deadlines")</span><span><i class="calendar-dot reservation" aria-hidden="true"></i>@T("Vehicle reservations")</span></div>
    @if(view!="Day")
    {
        <div class="calendar-scroll" tabindex="0" role="region" aria-label="@T("Calendar dates")"><div class="calendar-grid @(view=="Month"?"month":"week")">
            @foreach(var name in Weekdays){<div class="calendar-label">@T(name)</div>}
            @foreach(var date in Days)
            {
                var entries=Events(date);
                <button class="calendar-day @(date==selected.Date?"selected":"") @(date.Month!=selected.Month&&view=="Month"?"outside":"") @(date==Now.Date?"calendar-today":"")" data-date="@date.ToString("yyyy-MM-dd")" aria-pressed="@(date==selected.Date?"true":"false")" @onclick="()=>selected=date">
                    <span class="calendar-date">@date.Day</span><span class="calendar-event-count">@entries.Count</span><span class="calendar-mini-dots" aria-hidden="true">@foreach(var eventKind in new[]{"Trip","Service due","Reservation"}){if(entries.Any(e=>e.Kind==eventKind)){<i class="@("calendar-dot "+EventTone(eventKind))"></i>}}</span>
                    @foreach(var e in entries.Take(3)){<span class="calendar-chip @EventTone(e.Kind)">@e.Title · @T(e.Kind)</span>}
                    @if(entries.Count>3){<small class="calendar-more">+ @(entries.Count-3) @T("More events")</small>}
                    <span class="v4-sr-only">@DateLabel(date,entries.Count)</span>
                </button>
            }
        </div></div>
    }
</section>
<section class="panel calendar-agenda">
    <h2>@T("Agenda") · @selected.ToString("dddd, dd MMM yyyy",Locale)</h2>
    @if(Events(selected).Count==0){<p class="muted">@T("No matching events for this date.")</p>}
    @foreach(var entry in Events(selected))
    {
        <div class="agenda-row">
            <span class="calendar-chip @EventTone(entry.Kind)">@T(entry.Kind)</span>
            <div><strong>@entry.Title</strong><div class="muted">@T(entry.Detail)</div><small>@(entry.Kind!="Service due"?entry.Start.ToString("dd MMM HH:mm")+" – "+entry.End.ToString("dd MMM HH:mm"):T("All-day reminder"))</small></div>
            @if(entry.TripId is int id && Fleet.Trips.FirstOrDefault(t=>t.Id==id) is Trip trip && trip.Start>Now)
            {<button class="secondary" @onclick="()=>EditTrip.InvokeAsync(trip)">@T("Edit trip") #@id</button>}
        </div>
    }
</section>
@code {
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    [Parameter, EditorRequired] public FleetData Fleet {get;set;}=default!;
    [Parameter] public DateTime Now {get;set;}
    [Parameter] public IReadOnlyList<VehicleReservation> Reservations {get;set;}=[];
    [Parameter] public EventCallback<Trip> EditTrip {get;set;}
    [Parameter] public EventCallback<DateTime> PlanTrip {get;set;}
    private readonly string[] Views=["Day","Week","Month"];
    private readonly string[] Weekdays=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
    private string view="Week",kind="All";
    private int vehicleId;
    private DateTime selected;
    protected override void OnInitialized()=>selected=Now.Date;
    private DateTime GridStart=>view=="Month"?FleetCalendar.WeekStart(new DateTime(selected.Year,selected.Month,1)):FleetCalendar.WeekStart(selected);
    private IEnumerable<DateTime> Days=>Enumerable.Range(0,view=="Month"?42:7).Select(i=>GridStart.AddDays(i));
    private CultureInfo Locale=>CultureInfo.GetCultureInfo(Russian?"ru-RU":"en-US");
    private static string EventTone(string kind)=>kind switch{"Trip"=>"trip","Reservation"=>"reservation",_=>"service"};
    private string DateLabel(DateTime date,int count)=>$"{date.ToString("D",Locale)} · {T("Events")}: {count}";
    private string Heading=>view=="Month"?selected.ToString("MMMM yyyy",Locale):view=="Day"?selected.ToString("dd MMM yyyy",Locale):$"{GridStart.ToString("dd MMM",Locale)} – {GridStart.AddDays(6).ToString("dd MMM yyyy",Locale)}";
    private IReadOnlyList<CalendarEntry> Events(DateTime date)=>FleetCalendar.Entries(Fleet,date.Date,date.Date.AddDays(1),Reservations).Where(e=>(vehicleId==0||e.VehicleId==vehicleId)&&(kind=="All"||e.Kind==kind)).ToList();
    private void Move(int delta)=>selected=view=="Month"?selected.AddMonths(delta):selected.AddDays(delta*(view=="Week"?7:1));
    private void Today()=>selected=Now.Date;
    private Task NewTrip()=>PlanTrip.InvokeAsync(selected);
}
