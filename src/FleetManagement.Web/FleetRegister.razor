@inject IJSRuntime JS
<section class="panel">
    <div class="registerhead">
        <div><h2>@(IsVehicles ? "Vehicle register" : "Driver register")</h2><p class="muted">Manage synthetic records in the original spreadsheet-style interface.</p></div>
        <button @onclick="NewRecord">@(IsVehicles ? "+ Add vehicle" : "+ Add driver")</button>
    </div>
    <div class="actions registertools">
        <label>Search<input type="search" placeholder="Search records…" @bind="query" @bind:event="oninput" /></label>
        <label>Sort by<select @bind="sort"><option value="id">ID</option><option value="name">Name / registration</option><option value="metric">@(IsVehicles ? "Mileage" : "Experience")</option></select></label>
        <button class="secondary" @onclick="()=>descending=!descending">@(descending ? "Descending ↓" : "Ascending ↑")</button>
    </div>
    @if (feedback.Length > 0) { <p role="status" class="@(error ? "error" : "notice")">@feedback</p> }
    @if (editing)
    {
        <div class="editor">
            <h3>@(editId == 0 ? "New record" : $"Edit #{editId}")</h3>
            @if (IsVehicles)
            {
                <div class="formgrid">
                    <label>Registration<input @bind="plate" maxlength="40" /></label>
                    <label>Model<input @bind="name" maxlength="100" /></label>
                    <label>Current mileage (km)<input type="number" min="0" @bind="mileage" /></label>
                    <label>Last service mileage (km)<input type="number" min="0" @bind="serviceMileage" /></label>
                    <label>Last service date<input type="date" @bind="serviceDate" /></label>
                    <label>Service interval (km)<input type="number" min="1" max="1000000" @bind="intervalKm" /></label>
                    <label>Service interval (days)<input type="number" min="1" max="3650" @bind="intervalDays" /></label>
                </div>
            }
            else
            {
                <div class="formgrid">
                    <label>Full name<input @bind="name" maxlength="100" /></label>
                    <label>License number<input @bind="license" maxlength="50" /></label>
                    <label>Experience (years)<input type="number" min="0" max="70" @bind="experience" /></label>
                </div>
            }
            <div class="actions"><button @onclick="Save">Save record</button><button class="secondary" @onclick="Cancel">Cancel</button></div>
        </div>
    }
    <div class="tablewrap"><table>
    @if (IsVehicles)
    {
        <thead><tr><th>ID</th><th>Registration</th><th>Model</th><th>Mileage</th><th>Last service</th><th>Health</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach(var v in Vehicles)
        {
            <tr @key="v.Id"><td>@v.Id</td><td>@v.Plate</td><td>@v.Model</td><td>@v.Mileage.ToString("N0") km</td><td>@v.LastService.ToString("dd MMM yyyy")</td><td><span class="pill @FleetRules.Assess(v,Today).Status.ToLowerInvariant()">@FleetRules.Assess(v,Today).Status</span></td><td><div class="actions"><button class="secondary" @onclick="()=>OpenPassport.InvokeAsync(v.Id)">Passport</button><button class="secondary" @onclick="()=>EditVehicle(v)">Edit</button><button class="delete" @onclick="()=>Remove(v.Id)">Delete</button></div></td></tr>
        }
        @if(!Vehicles.Any()){<tr><td colspan="7">No matching vehicles.</td></tr>}
        </tbody>
    }
    else
    {
        <thead><tr><th>ID</th><th>Driver</th><th>License</th><th>Experience</th><th>Assigned trips</th><th>Active trips</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach(var d in Drivers)
        {
            <tr @key="d.Id"><td>@d.Id</td><td>@d.Name</td><td>@d.License</td><td>@d.Experience years</td><td>@Fleet.Trips.Count(t=>t.DriverId==d.Id)</td><td>@Fleet.Trips.Count(t=>t.DriverId==d.Id && FleetRules.TripStatus(t,Today)=="In transit")</td><td><div class="actions"><button class="secondary" @onclick="()=>EditDriver(d)">Edit</button><button class="delete" @onclick="()=>Remove(d.Id)">Delete</button></div></td></tr>
        }
        @if(!Drivers.Any()){<tr><td colspan="7">No matching drivers.</td></tr>}
        </tbody>
    }
    </table></div>
</section>
@code {
    [Parameter, EditorRequired] public FleetData Fleet {get;set;}=default!;
    [Parameter] public bool IsVehicles {get;set;}
    [Parameter] public DateTime Today {get;set;}
    [Parameter] public EventCallback Changed {get;set;}
    [Parameter] public EventCallback<int> OpenPassport {get;set;}
    [Parameter] public IReadOnlyList<MaintenanceEntry> MaintenanceEntries {get;set;}=[];
    private string query="",sort="id",name="",plate="",license="",feedback="";
    private bool descending,editing,error;
    private int editId,mileage,serviceMileage,intervalKm=10000,intervalDays=180,experience;
    private DateTime serviceDate=DateTime.Today;
    private bool Match(string text)=>text.Contains(query.Trim(),StringComparison.OrdinalIgnoreCase);
    private IEnumerable<Vehicle> Vehicles {
        get { var rows=Fleet.Vehicles.Where(v=>Match(v.Plate)||Match(v.Model)||Match(v.Id.ToString()));var ordered=sort switch{"name"=>rows.OrderBy(v=>v.Plate),"metric"=>rows.OrderBy(v=>v.Mileage),_=>rows.OrderBy(v=>v.Id)};return descending?ordered.Reverse():ordered; }
    }
    private IEnumerable<Driver> Drivers {
        get { var rows=Fleet.Drivers.Where(d=>Match(d.Name)||Match(d.License)||Match(d.Id.ToString()));var ordered=sort switch{"name"=>rows.OrderBy(d=>d.Name),"metric"=>rows.OrderBy(d=>d.Experience),_=>rows.OrderBy(d=>d.Id)};return descending?ordered.Reverse():ordered; }
    }
    private void NewRecord(){editing=true;editId=0;name=plate=license=feedback="";mileage=serviceMileage=experience=0;intervalKm=10000;intervalDays=180;serviceDate=Today.Date;}
    private void EditVehicle(Vehicle v){NewRecord();editId=v.Id;name=v.Model;plate=v.Plate;mileage=v.Mileage;serviceMileage=v.LastServiceMileage;serviceDate=v.LastService;intervalKm=v.ServiceIntervalKm;intervalDays=v.ServiceIntervalDays;}
    private void EditDriver(Driver d){NewRecord();editId=d.Id;name=d.Name;license=d.License;experience=d.Experience;}
    private void Cancel(){editing=false;feedback="";}
    private void Fail(string message){feedback=message;error=true;}
    private async Task Save(){
        if(IsVehicles){
            var id=editId==0?Fleet.Vehicles.Select(v=>v.Id).DefaultIfEmpty().Max()+1:editId;
            var item=new Vehicle(id,plate.Trim(),name.Trim(),mileage,serviceMileage,serviceDate.Date,intervalKm,intervalDays);
            if(FleetRules.ValidateVehicle(Fleet,item,Today) is string invalid){Fail(invalid);return;}
            var index=Fleet.Vehicles.FindIndex(v=>v.Id==id);if(index<0)Fleet.Vehicles.Add(item);else{
                var before=Fleet.Vehicles[index];
                if(MaintenanceJournal.ValidateVehicleEdit(before,item,MaintenanceEntries) is string historyError){Fail(historyError);return;}
                if(item.LastService.Date==before.LastService.Date)item=item with{LastService=before.LastService};
                Fleet.Vehicles[index]=item;
            }
        }else{
            var id=editId==0?Fleet.Drivers.Select(d=>d.Id).DefaultIfEmpty().Max()+1:editId;
            var item=new Driver(id,name.Trim(),license.Trim(),experience);
            if(FleetRules.ValidateDriver(Fleet,item) is string invalid){Fail(invalid);return;}
            var index=Fleet.Drivers.FindIndex(d=>d.Id==id);if(index<0)Fleet.Drivers.Add(item);else Fleet.Drivers[index]=item;
        }
        editing=false;error=false;feedback="Record saved.";await Changed.InvokeAsync();
    }
    private async Task Remove(int id){
        var invalid=IsVehicles?(FleetRules.CanRemoveVehicle(Fleet,id)??MaintenanceJournal.CanRemove(id,MaintenanceEntries)):FleetRules.CanRemoveDriver(Fleet,id);
        if(invalid is not null){Fail(invalid);return;}
        if(!await JS.InvokeAsync<bool>("confirm","Delete this demo record?"))return;
        if(IsVehicles)Fleet.Vehicles.RemoveAll(v=>v.Id==id);else Fleet.Drivers.RemoveAll(d=>d.Id==id);
        if(editId==id)editing=false;error=false;feedback="Record deleted.";await Changed.InvokeAsync();
    }
}
