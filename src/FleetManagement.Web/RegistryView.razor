@using Microsoft.AspNetCore.Components.Forms
<section class="panel"><h2>Model registry</h2><p class="muted">Import manifest.json from a local ML.NET run or GitHub Actions registry artifact. Metadata only: no ZIP execution, model loading, network upload or automatic promotion. Imported claims and hashes are not independently verified here.</p>
<label>Experiment manifests (JSON, up to 64 KiB each)<InputFile OnChange="Import" multiple accept=".json,application/json"/></label>
<div class="actions"><button class="secondary" @onclick="Clear">Clear imported experiments</button><a href="https://github.com/ViolettaNcl/FleetManagement/actions/workflows/ml-ci.yml" target="_blank" rel="noopener noreferrer">Open ML training artifacts</a></div>
@if(message.Length>0){<p role="status" class="notice">@message</p>}</section>
@if(entries.Count>0){
    <section class="panel"><h2>Experiment history</h2><div class="tablewrap"><table><thead><tr><th>Run</th><th>Seed</th><th>Logistic F1</th><th>FastTree F1</th><th>Linear MAE</th><th>FastTree MAE</th><th>Compare</th></tr></thead><tbody>@foreach(var entry in entries.OrderByDescending(x=>x.CreatedUtc)){<tr><td><button class="secondary" @onclick="()=>selected=entry.RunId">@entry.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</button></td><td>@entry.Seed</td><td>@entry.LogisticF1.ToString("P1")</td><td>@entry.FastTreeF1.ToString("P1")</td><td>@entry.LinearMae.ToString("F2")</td><td>@entry.FastTreeMae.ToString("F2")</td><td>@(RegistryManifest.Comparable(Current,entry)?"Same test data":"Different test data")</td></tr>}</tbody></table></div></section>
    var current=Current;
    <div class="split"><section class="panel"><h2>Maintenance benchmark</h2><p>Held-out samples: @current.MaintenanceRows</p><div class="tablewrap"><table><thead><tr><th>Model</th><th>F1 ↑</th><th>Brier ↓</th></tr></thead><tbody><tr><td>Logistic</td><td>@current.LogisticF1.ToString("P1")</td><td>@current.LogisticBrier.ToString("F3")</td></tr><tr><td>FastTree</td><td>@current.FastTreeF1.ToString("P1")</td><td>@current.FastTreeBrier.ToString("F3")</td></tr></tbody></table></div><p class="muted">F1 and Brier measure different properties. No automatic winner is promoted.</p></section>
    <section class="panel"><h2>ETA benchmark</h2><p>Held-out samples: @current.EtaRows</p><div class="tablewrap"><table><thead><tr><th>Model</th><th>MAE ↓</th><th>RMSE ↓</th></tr></thead><tbody><tr><td>Linear</td><td>@current.LinearMae.ToString("F2")</td><td>@current.LinearRmse.ToString("F2")</td></tr><tr><td>FastTree</td><td>@current.FastTreeMae.ToString("F2")</td><td>@current.FastTreeRmse.ToString("F2")</td></tr></tbody></table></div><p class="muted">Errors in minutes; synthetic journeys only.</p></section></div>
    <section class="panel"><h2>Experiment provenance</h2><dl class="registry-details"><dt>Run ID</dt><dd>@current.RunId</dd><dt>Source revision</dt><dd>@current.Revision</dd><dt>ML.NET</dt><dd>@current.Version</dd><dt>Maintenance test fingerprint</dt><dd>@current.MaintenanceTestHash</dd><dt>ETA test fingerprint</dt><dd>@current.EtaTestHash</dd><dt>Reported maintenance artifact hash</dt><dd>@current.MaintenanceHash</dd><dt>Reported ETA artifact hash</dt><dd>@current.EtaHash</dd></dl><p class="muted">Compare experiments only when their datasets and evaluation protocol match. Matching hashes do not authenticate imported files. This session-only viewer does not persist imported metadata.</p></section>
}
@code{
    private readonly List<RegistryEntry> entries=[];
    private string selected="",message="";
    private RegistryEntry Current=>entries.Single(x=>x.RunId==selected);
    private async Task Import(InputFileChangeEventArgs e){
        if(e.FileCount>10){message="Select at most 10 manifests at once.";return;}
        int added=0,rejected=0;
        foreach(var file in e.GetMultipleFiles(10)){
            try{
                if(entries.Count>=50)throw new FormatException("Session limit reached.");
                using var reader=new StreamReader(file.OpenReadStream(RegistryManifest.MaxBytes));
                var entry=RegistryManifest.Parse(await reader.ReadToEndAsync());
                if(entries.Any(x=>x.RunId==entry.RunId))throw new FormatException("Duplicate run ID.");
                entries.Add(entry);selected=entry.RunId;added++;
            }catch(Exception ex) when(ex is IOException or FormatException or InvalidOperationException){rejected++;}
        }
        message=$"Imported {added}; rejected {rejected} (invalid, duplicate, oversized or session limit).";
    }
    private void Clear(){entries.Clear();selected="";message="Session registry cleared.";}
}
