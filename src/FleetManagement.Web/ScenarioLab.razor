@using FleetManagement.Web
<section class="panel"><div class="registerhead"><div><h2>@T("What-if scenario lab")</h2><p class="muted">@T("Run three complete synthetic fleet scenarios with the same initialization seed. Compare delivery completion, elapsed simulation time and fuel. This is an experiment, not a real traffic or cost forecast.")</p></div><button @onclick="Compare">@T("Compare scenarios")</button></div>
<div class="formgrid"><label>@T("Virtual vehicles")<input type="number" min="4" max="24" @bind="count"/></label><label>@T("Scenario seed")<input type="number" @bind="seed"/></label><label>@T("Baseline traffic (0–1)")<input type="number" step=".1" min="0" max="1" @bind="baseline"/></label><label>@T("Alternative traffic (0–1)")<input type="number" step=".1" min="0" max="1" @bind="alternative"/></label></div>
@if(error.Length>0){<p class="error" role="status">@error</p>}
</section>
@if(results.Count>0){
    <section class="panel"><h2>@T("Scenario outcomes")</h2><p class="muted">@T("Each scenario ends when all vehicles arrive or break down, or at the 12-hour limit. Elapsed time is not a success metric by itself: a breakdown may end a scenario earlier.")</p>
    <div class="tablewrap" role="region" tabindex="0" aria-label="@T("Scenario comparison")"><table><thead><tr><th>@T("Scenario")</th><th>@T("Arrived")</th><th>@T("Breakdowns")</th><th>@T("Unfinished")</th><th>@T("Elapsed")</th><th>@T("Distance")</th><th>@T("Fuel")</th><th>L/100 km</th></tr></thead><tbody>@foreach(var r in results){<tr><td>@r.Name</td><td>@r.Arrived / @r.Vehicles</td><td>@r.BrokenDown</td><td>@r.Unfinished</td><td>@r.ElapsedMinutes min</td><td>@r.DistanceKm.ToString("F1") km</td><td>@r.FuelLitres.ToString("F1") L</td><td>@(r.FuelPer100Km?.ToString("F1")??"—")</td></tr>}</tbody></table></div>
    </section>
    <div class="split"><section class="panel"><h2>@T("Completion rate")</h2>@foreach(var r in results){<div class="reportbar"><div><strong>@r.Name</strong><span>@r.CompletionRate.ToString("P0")</span></div><div class="progress"><i style="@Width(r.CompletionRate)"></i></div></div>}</section>
    <section class="panel"><h2>@T("Fuel per 100 km")</h2>@foreach(var r in results){<div class="reportbar"><div><strong>@r.Name</strong><span>@(r.FuelPer100Km?.ToString("F1")??"—") L</span></div><div class="progress"><i style="@Width((r.FuelPer100Km??0)/Math.Max(1,results.Max(x=>x.FuelPer100Km??0)))"></i></div></div>}<p class="muted">@T("Total fuel can be lower when less distance is completed. Compare both completion and normalized consumption.")</p></section></div>
    <section class="panel"><h2>@T("Experiment notes")</h2><p>@T("Same seeded initial fleet; incident paths can consume random numbers differently after divergence. This is a deterministic scenario comparison, not a controlled real-world causal estimate. The fuel formula is simulated. No automatic assignment or change to saved records.")</p></section>
}
@code{
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    private int count=8,seed=42;
    private double baseline=.2,alternative=.8;
    private string error="";
    private LogisticMaintenanceModel? maintenance;
    private EtaModel? eta;
    private IReadOnlyList<ScenarioResult> results=[];
    private void Compare(){if(count is <4 or >24||!(baseline is >=0 and <=1)||!(alternative is >=0 and <=1)){error="Choose 4–24 vehicles and traffic ratios from 0 to 1.";return;}error="";maintenance??=MaintenanceLearning.Train().Model;eta??=EtaLearning.Train().Model;results=ScenarioComparison.Compare(count,seed,baseline,alternative,maintenance,eta);}
    private static string Width(double ratio)=>"width:"+(100*Math.Clamp(ratio,0,1)).ToString("F2",CultureInfo.InvariantCulture)+"%";
}
