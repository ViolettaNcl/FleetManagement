@using FleetManagement.Web
@using Microsoft.AspNetCore.Components.Forms
<section class="panel suite-panel" aria-labelledby="snapshot-restore-title">
    <div class="suite-heading"><div><span class="suite-kicker">@T("Local recovery")</span><h2 id="snapshot-restore-title">@T("Restore demo snapshot")</h2><p class="muted">@T("Choose a JSON or fleet snapshot XLSX file (up to 4 MiB). Validate before replacing current demo records. Excel import requires the exported template with unchanged headers and ISO text dates. Export current data first.")</p></div></div>
    <label class="snapshot-file-label" for="snapshot-input">@T("Choose demo JSON or XLSX")</label>
    <InputFile id="snapshot-input" accept=".json,.xlsx,application/json,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" OnChange="Read" disabled="@busy" />
    @if(message.Length>0){<p role="status" class="@(error?"error":"notice")">@T(message)</p>}
    @if(candidate is not null){
        <div class="suite-note">
            <h3>@T("Validated snapshot preview")</h3>
            <p>@T("Simulation time"): @candidate.Now.ToString("yyyy-MM-dd HH:mm")</p>
            <div class="metrics suite-metrics"><div class="metric">@T("Vehicles")<strong>@candidate.Data.Vehicles.Count</strong></div><div class="metric">@T("Drivers")<strong>@candidate.Data.Drivers.Count</strong></div><div class="metric">@T("Trips")<strong>@candidate.Data.Trips.Count</strong></div><div class="metric">@T("Maintenance Journal")<strong>@(candidate.MaintenanceEntries?.Count??0)</strong></div></div>
            <p class="muted">@T("Shifts"): @(candidate.DriverShifts?.Count??0) · @T("Reservations"): @(candidate.VehicleReservations?.Count??0)</p>
            <label class="dashboard-check"><input type="checkbox" @bind="confirmed"/><span>@T("Replace all current demo records with this validated snapshot")</span></label>
            <div class="actions"><button @onclick="Apply" disabled="@(!confirmed||busy)">@T("Restore validated snapshot")</button><button class="secondary" @onclick="Discard" disabled="@busy">@T("Discard snapshot")</button></div>
        </div>
    }
</section>
@code{
    [Parameter] public bool Russian{get;set;}
    [Parameter,EditorRequired] public Func<DemoSnapshot,Task<bool>> Restore{get;set;}=default!;
    private DemoSnapshot? candidate;
    private bool confirmed,busy,error;
    private string message="";
    private string T(string value)=>DemoLocale.Text(value,Russian);
    private void Discard(){candidate=null;confirmed=false;message="";error=false;}
    private async Task Read(InputFileChangeEventArgs args){
        if(busy)return;
        Discard();busy=true;
        try{
            if(args.File.Size>SnapshotValidation.MaxBytes){message="Snapshot file exceeds 4 MiB.";error=true;return;}
            await using var stream=args.File.OpenReadStream(SnapshotValidation.MaxBytes);
            DemoSnapshot? parsed;
            if(args.File.Name.EndsWith(".xlsx",StringComparison.OrdinalIgnoreCase)){
                using var buffer=new MemoryStream();await stream.CopyToAsync(buffer);
                var workbook=FleetReport.ImportSnapshotXlsx(buffer.ToArray());
                parsed=new(workbook.Data,workbook.Now,workbook.Maintenance,workbook.Shifts,workbook.RequireShifts,workbook.Reservations);
            }else if(args.File.Name.EndsWith(".json",StringComparison.OrdinalIgnoreCase))parsed=await JsonSerializer.DeserializeAsync(stream,DemoJsonContext.Default.DemoSnapshot);
            else{message="Choose a JSON or XLSX snapshot.";error=true;return;}
            var reason=SnapshotValidation.Check(parsed?.Data,parsed?.Now??default,parsed?.MaintenanceEntries,parsed?.DriverShifts,parsed?.VehicleReservations);
            if(reason is not null||parsed is null){message=reason??"Snapshot structure or clock is invalid.";error=true;return;}
            candidate=parsed;message="Snapshot validated. No records have changed.";
        }catch(FormatException ex){message=ex.Message;error=true;}
        catch(JsonException){message="Invalid demo JSON.";error=true;}
        catch(IOException){message="Unable to read the selected file.";error=true;}
        catch(InvalidOperationException){message="Unable to read the selected file.";error=true;}
        finally{busy=false;}
    }
    private async Task Apply(){
        if(candidate is null||!confirmed||busy)return;
        busy=true;
        try{
            if(await Restore(candidate)){Discard();message="Demo snapshot restored.";}
            else{message="Unable to save snapshot; current records were not replaced.";error=true;}
        }finally{busy=false;}
    }
}
