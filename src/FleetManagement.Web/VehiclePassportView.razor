@using FleetManagement.Web
<section class="panel"><div class="registerhead"><div><h2>@T("Digital vehicle passport")</h2><p class="muted">@T("A unified view of a registered demo vehicle: current record, latest recorded service, trip history and upcoming assignments. Not a verified real vehicle history.")</p></div><button class="secondary" @onclick='()=>Open.InvokeAsync("Vehicles")'>@T("Back to vehicle register")</button></div>
@if(Fleet.Vehicles.Count>0){<label>@T("Passport vehicle")<select value="@SelectedId" @onchange="SelectVehicle">@foreach(var vehicle in Fleet.Vehicles.OrderBy(v=>v.Plate)){<option value="@vehicle.Id">@vehicle.Plate · @vehicle.Model</option>}</select></label>}
else{<p>@T("No vehicles in the register.")</p>}</section>
@if(VehiclePassports.Build(Fleet,SelectedId,Now) is VehiclePassport p){
    <section class="panel"><div class="registerhead"><div><h2>@p.Vehicle.Plate · @p.Vehicle.Model</h2><p class="muted">@T("Registered mileage and scheduled trip distances are independent demo fields.")</p></div><span class="pill @p.Service.Status.ToLowerInvariant()">@T(p.Service.Status)</span></div>
    <div class="enterprise-passport-layout"><VehicleImage Model="@p.Vehicle.Model"/><div class="metrics"><div class="metric">@T("Odometer")<strong>@p.Vehicle.Mileage.ToString("N0") <small>km</small></strong></div><div class="metric">@T("Completed trips")<strong>@p.CompletedTrips</strong></div><div class="metric">@T("Completed trip distance")<strong>@p.CompletedDistance.ToString("N0") <small>km</small></strong></div><div class="metric">@T("Upcoming trips")<strong>@p.ScheduledTrips</strong></div></div></div>
    </section>
    <div class="split"><section class="panel"><h2>@T("Maintenance profile")</h2><dl class="registry-details"><dt>@T("Last recorded service")</dt><dd>@p.Vehicle.LastService.ToString("dd MMM yyyy")</dd><dt>@T("Odometer at service")</dt><dd>@p.Vehicle.LastServiceMileage.ToString("N0") km</dd><dt>@T("Distance since service")</dt><dd>@p.DistanceSinceService.ToString("N0") km</dd><dt>@T("Remaining interval")</dt><dd>@p.Service.RemainingKm.ToString("N0") km / @p.Service.RemainingDays days</dd><dt>@T("Calendar deadline")</dt><dd>@p.NextServiceDate.ToString("dd MMM yyyy")</dd></dl><p>@p.Service.Reason</p><button class="secondary" @onclick='()=>Open.InvokeAsync("Maintenance")'>@T("Review maintenance")</button><p class="muted">@T("The latest service fields track interval resets. Earlier work before journal adoption cannot be reconstructed.")</p></section>
    <section class="panel"><h2>@T("Trip activity")</h2>@foreach(var status in new[]{"Completed","In transit","Scheduled"}){var count=p.Trips.Count(t=>t.Status==status);<div class="reportbar"><div><strong>@T(status)</strong><span>@count</span></div><div class="progress"><i style="@Width(count,p.Trips.Count)"></i></div></div>}<button class="secondary" @onclick='()=>Open.InvokeAsync("Calendar")'>@T("Open calendar")</button></section></div>
    <section class="panel"><h2>@T("Vehicle maintenance history")</h2><MaintenanceHistory Russian="Russian" Fleet="Fleet" Entries="@(MaintenanceEntries.Where(e=>e.VehicleId==p.Vehicle.Id).ToArray())"/></section>
    <section class="panel"><h2>@T("Vehicle trip history")</h2><label>@T("Trip status")<select @bind="filter"><option value="All">@T("All")</option><option value="Completed">@T("Completed")</option><option value="In transit">@T("In transit")</option><option value="Scheduled">@T("Scheduled")</option></select></label>
    <div class="tablewrap" role="region" tabindex="0" aria-label="@T("Trip history")"><table><thead><tr><th>@T("Trip")</th><th>@T("Route")</th><th>@T("Driver")</th><th>@T("Departure")</th><th>@T("Arrival")</th><th>@T("Distance")</th><th>@T("Status")</th><th>@T("Action")</th></tr></thead><tbody>@foreach(var row in p.Trips.Where(t=>filter=="All"||t.Status==filter)){<tr><td>#@row.Trip.Id</td><td>@row.Trip.Origin → @row.Trip.Destination</td><td>@row.Driver</td><td>@row.Trip.Start.ToString("dd MMM HH:mm")</td><td>@row.Trip.End.ToString("dd MMM HH:mm")</td><td>@row.Trip.Distance km</td><td>@T(row.Status)</td><td>@if(row.Status=="Scheduled"){<button class="secondary" @onclick="()=>EditTrip.InvokeAsync(row.Trip)">@T("Edit trip")</button>}</td></tr>}</tbody></table></div>
    @if(!p.Trips.Any(t=>filter=="All"||t.Status==filter)){<p>@T("No matching trips.")</p>}</section>
}
@code{
    [Parameter] public bool Russian{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    [Parameter,EditorRequired] public FleetData Fleet{get;set;}=default!;
    [Parameter] public DateTime Now{get;set;}
    [Parameter] public IReadOnlyList<MaintenanceEntry> MaintenanceEntries{get;set;}=[];
    [Parameter] public int SelectedId{get;set;}
    [Parameter] public EventCallback<int> SelectedIdChanged{get;set;}
    [Parameter] public EventCallback<string> Open{get;set;}
    [Parameter] public EventCallback<Trip> EditTrip{get;set;}
    private string filter="All";
    private async Task SelectVehicle(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var id)){filter="All";await SelectedIdChanged.InvokeAsync(id);}}
    private static string Width(int count,int total)=>"width:"+(total==0?0:100.0*count/total).ToString("F2",CultureInfo.InvariantCulture)+"%";
}
