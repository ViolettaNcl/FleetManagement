@using FleetManagement.Web
@inject IJSRuntime JS
<section class="panel suite-panel custom-report-panel" aria-labelledby="report-builder-title">
    <div class="suite-heading"><div><span class="suite-kicker">@T("Custom reporting")</span><h2 id="report-builder-title">@T("Vehicle report builder")</h2><p class="muted">@T("Filter the current date cohort and select export columns. Registration is always included. Preview and workbook use identical filters.")</p></div><button @onclick="Export" disabled="@(!Options.Valid)">@T("Export custom Excel")</button></div>
    <div class="formgrid"><label>@T("Report service status")<select aria-label="@T("Report service status")" @bind="service" @bind:after="ResetPage"><option value="All">@T("All")</option><option value="Healthy">@T("Healthy")</option><option value="Soon">@T("Soon")</option><option value="Due">@T("Due")</option></select></label><label>@T("Report vehicle search")<input type="search" aria-label="@T("Report vehicle search")" maxlength="100" @bind="query" @bind:event="oninput" @bind:after="ResetPage"/></label><label>@T("Minimum trips")<input type="number" aria-label="@T("Minimum trips")" min="0" max="100000" @bind="minimum" @bind:after="ResetPage"/></label><label>@T("Report sort order")<select aria-label="@T("Report sort order")" @bind="sort" @bind:after="ResetPage"><option value="Registration">@T("Registration")</option><option value="Trips">@T("Most trips")</option><option value="Distance">@T("Longest completed distance")</option><option value="Service">@T("Service urgency")</option></select></label></div>
    <fieldset class="suite-fieldset"><legend>@T("Export columns")</legend>
        <label class="dashboard-check"><input type="checkbox" @bind="model"/><span>@T("Model")</span></label>
        <label class="dashboard-check"><input type="checkbox" @bind="counts"/><span>@T("Trip counts")</span></label>
        <label class="dashboard-check"><input type="checkbox" @bind="distance"/><span>@T("Completed distance")</span></label>
        <label class="dashboard-check"><input type="checkbox" @bind="serviceColumn"/><span>@T("Service status")</span></label>
    </fieldset>
    <details class="suite-queue-details"><summary>@T("Report templates")</summary><p class="muted">@T("Apply a built-in template or save one custom configuration locally. Search text and period dates are not stored.")</p><div class="actions template-actions"><button class="secondary" @onclick='()=>ApplyBuiltIn("All")'>@T("Full fleet template")</button><button class="secondary" @onclick='()=>ApplyBuiltIn("Due")'>@T("Service due template")</button><button class="secondary" @onclick='()=>ApplyBuiltIn("Distance")'>@T("Distance template")</button><button class="secondary" @onclick="SaveTemplate" disabled="@(!Options.Valid)">@T("Save custom template")</button><button class="secondary" @onclick="LoadTemplate">@T("Load custom template")</button></div></details>
    @if(!Options.Valid){<p class="error" role="status">@T("Invalid report options.")</p>}
    else{
        var rows=FleetReport.FilterVehicles(Summary,Options);
        var pages=Math.Max(1,(rows.Count+PageSize-1)/PageSize);var shownPage=Math.Min(page,pages-1);
        <p class="muted" role="status" data-testid="custom-report-count">@rows.Count / @Summary.VehicleRows.Count @T("vehicles in report") · @T("Page") @(shownPage+1) / @pages</p>
        <div class="tablewrap" tabindex="0" role="region" aria-label="@T("Custom report preview")"><table><thead><tr><th>@T("Registration")</th>@if(model){<th>@T("Model")</th>}@if(counts){<th>@T("Trips")</th><th>@T("Completed")</th>}@if(distance){<th>@T("Completed distance")</th>}@if(serviceColumn){<th>@T("Service status")</th>}</tr></thead><tbody>
        @foreach(var row in rows.Skip(shownPage*PageSize).Take(PageSize)){<tr><td>@row.Registration</td>@if(model){<td>@row.Model</td>}@if(counts){<td>@row.Trips</td><td>@row.CompletedTrips</td>}@if(distance){<td>@row.CompletedDistanceKm km</td>}@if(serviceColumn){<td>@T(row.ServiceStatus)</td>}</tr>}
        </tbody></table></div>
        <div class="suite-pagination"><button class="secondary" disabled="@(shownPage==0)" @onclick="()=>page=Math.Max(0,shownPage-1)">@T("Previous report page")</button><span>@(rows.Count==0?0:shownPage*PageSize+1) – @Math.Min(rows.Count,(shownPage+1)*PageSize) / @rows.Count</span><button class="secondary" disabled="@(shownPage>=pages-1)" @onclick="()=>page=shownPage+1">@T("Next report page")</button></div>
        @if(rows.Count==0){<p class="muted">@T("No matching vehicles.")</p>}
        <div class="suite-note print-controls"><h3>@T("Printable report")</h3><p class="muted">@T("Prepare the full filtered report, then use your browser print dialog to print or save as PDF.")</p><div class="actions"><button class="secondary" @onclick="()=>printReady=!printReady">@T(printReady?"Close print preview":"Prepare printable report")</button>@if(printReady){<button @onclick="Print">@T("Print or save PDF")</button><span role="status">@rows.Count @T("vehicles in report")</span>}</div></div>
    }
    @if(feedback.Length>0){<p class="notice" role="status">@T(feedback)</p>}
    @if(printReady&&Options.Valid){<PrintableVehicleReport Russian="Russian" Summary="Summary" Options="Options" From="From" To="To" Now="Now"/>}
</section>
@code{
    [Parameter] public bool Russian{get;set;}
    [Parameter,EditorRequired] public FleetSummary Summary{get;set;}=default!;
    [Parameter] public DateTime From{get;set;}
    [Parameter] public DateTime To{get;set;}
    [Parameter] public DateTime Now{get;set;}
    private string T(string value)=>DemoLocale.Text(value,Russian);
    private string service="All",query="",feedback="";
    private int minimum,page;
    private bool printReady;
    private const string TemplateKey="fleetmanagement.preferences.report-template.v6";
    private const int PageSize=25;
    private string sort="Registration";
    private void ResetPage()=>page=0;
    private bool model=true,counts=true,distance=true,serviceColumn=true;
    private VehicleReportOptions Options=>new(service,query,minimum,model,counts,distance,serviceColumn,sort);
    private void Apply(VehicleReportOptions options){service=options.Service;sort=options.Sort;minimum=options.MinimumTrips;model=options.Model;counts=options.Counts;distance=options.Distance;serviceColumn=options.ServiceColumn;query="";page=0;feedback="Report template applied.";}
    private void ApplyBuiltIn(string kind)=>Apply(kind switch{
        "Due"=>new("Due","",0,true,false,false,true,"Service"),
        "Distance"=>new("All","",0,true,true,true,false,"Distance"),
        _=>new("All","",0,true,true,true,true,"Registration")
    });
    private async Task SaveTemplate(){
        if(!Options.Valid)return;
        try{await JS.InvokeVoidAsync("localStorage.setItem",TemplateKey,ReportTemplate.Encode(Options));feedback="Custom report template saved.";}
        catch(JSException){feedback="Unable to save report template.";}
    }
    private async Task LoadTemplate(){
        try{var raw=await JS.InvokeAsync<string?>("localStorage.getItem",TemplateKey);var options=ReportTemplate.Decode(raw);if(options is null){feedback="No valid saved report template.";return;}Apply(options);}
        catch(JSException){feedback="No valid saved report template.";}
    }
    private async Task Print(){if(printReady&&Options.Valid)try{await JS.InvokeVoidAsync("fleetPrintReport");}catch(JSException){feedback="Unable to open print dialog.";}}
    private async Task Export(){
        if(!Options.Valid)return;
        try{var bytes=FleetReport.ExportVehicleXlsx(Summary,From,To,Options,Russian);await JS.InvokeVoidAsync("fleetDownload",Convert.ToBase64String(bytes),$"fleet-custom-{From:yyyy-MM-dd}-{To:yyyy-MM-dd}.xlsx");feedback="Custom workbook generated.";}
        catch(JSException){feedback="Unable to download the workbook in this browser.";}
    }
}
